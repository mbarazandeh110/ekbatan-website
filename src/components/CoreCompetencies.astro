---
import { getCollection } from 'astro:content';

const allServices = await getCollection('services');
const sortedServices = allServices.sort(
  (a, b) => a.data.order - b.data.order || a.id.localeCompare(b.id)
);

const serviceIcons: Record<string, string> = {
  kubernetes: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" /></svg>`,
  ceph: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4" /></svg>`,
  'enterprise-databases': `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16" /></svg>`,
  'elasticsearch-enterprise': `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-4.35-4.35M11 19a8 8 0 100-16 8 8 0 000 16z" /></svg>`,
  'edge-cdn-networking': `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`,
  'mlops-ai-clusters': `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>`,
  'enterprise-devops-gitlab': `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /></svg>`,
};

const defaultIcon = `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>`;
---

<section id="infrastructure" class="relative py-28 px-6 max-w-7xl mx-auto scroll-mt-20">
  <div class="absolute -top-10 right-1/4 w-96 h-96 bg-cyan-500/5 blur-[120px] pointer-events-none rounded-full"></div>

  <div class="text-center mb-20">
    <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-cyan-950/40 border border-cyan-800/40 text-[11px] font-mono text-cyan-400 mb-4">
      <span>CORE CAPABILITIES</span>
    </div>
    <h2 class="text-3xl md:text-5xl font-black text-white tracking-tight">
      تخصص‌های هسته‌ای <span class="bg-gradient-to-r from-cyan-400 to-indigo-400 bg-clip-text text-transparent">شرکت اکباتان</span>
    </h2>
    <p class="text-slate-400 max-w-2xl mx-auto mt-4 text-sm md:text-base leading-relaxed">
      ما زیرساخت را بر اساس نیازمندی‌ها و محدودیت‌های پروژه شما مهندسی می‌کنیم؛ با تمرکز بر پایداری، امنیت و عملیاتی‌سازی در مقیاس‌های بزرگ.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {sortedServices.map((srv, index) => {
      const isLastLoneItem = index === sortedServices.length - 1 && sortedServices.length % 3 === 1;
      return (
        <a
          href={`/services/${srv.id}/`}
          class:list={[
            'group relative p-7 rounded-2xl bg-gradient-to-b from-[#0f172a]/70 to-[#070b14]/90 border border-slate-800/80 hover:border-cyan-500/40 hover:shadow-[0_12px_40px_rgba(6,182,212,0.1)] transition-all duration-300 flex flex-col justify-between cursor-pointer',
            isLastLoneItem && 'lg:col-span-3 lg:flex-row lg:items-center lg:gap-8',
          ]}
        >
          <div class={isLastLoneItem ? 'lg:flex-1' : ''}>
            <div class="flex items-center justify-between mb-5">
              <span class="text-[10px] font-mono tracking-wider font-semibold text-cyan-400 bg-cyan-950/60 border border-cyan-800/40 px-2.5 py-1 rounded-md">
                {srv.data.tag}
              </span>
              <div class="text-slate-400 group-hover:text-cyan-400 group-hover:scale-110 transition-all duration-300" set:html={serviceIcons[srv.id] || defaultIcon} />
            </div>

            <h3 class="text-lg font-bold text-white mb-3 group-hover:text-cyan-200 transition-colors leading-snug">
              {srv.data.title}
            </h3>

            <p class="text-slate-300/80 text-xs md:text-sm leading-relaxed font-normal">
              {srv.data.description}
            </p>
          </div>

          <div
            class:list={[
              'pt-5 mt-6 border-t border-slate-800/60 flex items-center justify-between text-[11px] text-slate-400',
              isLastLoneItem && 'lg:pt-0 lg:mt-0 lg:border-t-0 lg:border-r lg:pr-8 lg:shrink-0 lg:gap-3',
            ]}
          >
            <span class="group-hover:text-cyan-300 transition-colors font-medium">بررسی معماری و جزئیات</span>
            <span class="font-mono text-cyan-400 group-hover:translate-x-[-3px] transition-transform">←</span>
          </div>
        </a>
      );
    })}
  </div>
</section>