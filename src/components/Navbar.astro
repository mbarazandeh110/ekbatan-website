---
import { getCollection } from 'astro:content';

const allServices = await getCollection('services');
const sortedServices = allServices.sort(
  (a, b) => a.data.order - b.data.order || a.id.localeCompare(b.id)
);

const allTools = (await getCollection('tools')).sort((a, b) =>
  a.data.name.localeCompare(b.data.name)
);

const navItems = [
  { name: 'استک‌های سازمانی', href: '/enterprise/' },
  { name: 'مطالعات موردی', href: '/experience/' },
  { name: 'مدل‌های همکاری', href: '/#engagement' },
  { name: 'بلاگ مهندسی', href: '/blog/' },
  { name: 'درباره ما', href: '/about/' },
];
---

<header class="sticky top-0 z-[100] backdrop-blur-xl bg-[#050811]/90 border-b border-slate-800 transition-all">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      <a href="/" class="flex items-center gap-3.5 group focus:outline-none relative z-10">
        <div class="relative flex items-center justify-center w-11 h-11 rounded-xl bg-slate-900 border border-slate-700 group-hover:border-cyan-500/50 transition-colors shadow-inner">
          <picture>
            <source srcset="/Ekbatan_logo.webp" type="image/webp" />
            <img
              src="/Ekbatan_logo.png"
              alt="لوگوی شرکت اکباتان"
              class="h-7 w-7 object-contain opacity-95 group-hover:scale-105 transition-transform"
              width="28"
              height="28"
              loading="eager"
              decoding="async"
            />
          </picture>
        </div>
        <div class="flex flex-col">
          <span class="text-lg font-black tracking-wider text-white font-mono leading-none group-hover:text-cyan-400 transition-colors">EKBATAN</span>
          <span class="text-[10px] font-mono text-cyan-400 tracking-[0.2em] uppercase mt-1">Cloud Systems</span>
        </div>
      </a>

      <nav class="hidden lg:flex items-center gap-1 xl:gap-2 relative z-10" aria-label="منوی اصلی">
        <!-- مگا منوی دو ستونه با پشتیبانی کامل کیبورد (focus-within) -->
        <div class="relative group/menu py-5">
          <a
            href="/services/"
            aria-haspopup="true"
            class="nav-item flex items-center gap-1.5 px-3 py-2 text-sm font-medium text-slate-300 hover:text-cyan-400 rounded-lg transition-colors focus-visible:ring-2 focus-visible:ring-cyan-500 outline-none"
          >
            <span>خدمات تخصصی</span>
            <svg class="w-4 h-4 text-slate-500 transition-transform duration-300 group-hover/menu:rotate-180 group-focus-within/menu:rotate-180 group-hover/menu:text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </a>

          <div class="absolute top-[calc(100%-8px)] right-0 w-[calc(100vw-2rem)] lg:w-[760px] xl:w-[920px] max-w-[calc(100vw-2rem)] bg-[#020617] border border-cyan-900/60 rounded-2xl shadow-[0_30px_60px_-10px_rgba(0,0,0,1)] opacity-0 invisible group-hover/menu:opacity-100 group-hover/menu:visible group-focus-within/menu:opacity-100 group-focus-within/menu:visible transition-all duration-300 translate-y-3 group-hover/menu:translate-y-0 group-focus-within/menu:translate-y-0 z-[999] overflow-hidden flex flex-col">
            <div class="flex items-center justify-between px-6 py-4 border-b border-slate-800 bg-[#020617] relative z-10">
              <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
                <span class="text-xs font-mono font-semibold tracking-wider text-slate-300 uppercase">Architecture &amp; Deployment Catalog</span>
              </div>
              <a href="/services/" class="text-xs font-semibold text-cyan-400 hover:text-cyan-300 flex items-center gap-1 transition-colors bg-cyan-950/30 px-3 py-1.5 rounded-lg border border-cyan-900/50">
                کاتالوگ جامع خدمات
                <span class="font-mono">←</span>
              </a>
            </div>

            <div class="grid grid-cols-12">
              <!-- ستون راست: تمام ۷ خدمت هسته‌ای -->
              <div class="col-span-7 p-5 bg-[#0B1221]">
                <div class="text-[11px] font-mono text-cyan-400 uppercase tracking-wider mb-3">Core Infrastructure Services</div>
                <div class="grid grid-cols-2 gap-2.5">
                  {sortedServices.map((srv) => (
                    <a
                      href={`/services/${srv.id}/`}
                      class="group block p-3.5 rounded-xl bg-[#070b14] border border-slate-800/80 hover:border-cyan-500/40 focus-visible:border-cyan-400 outline-none transition-all"
                    >
                      <span class="text-[10px] font-mono text-cyan-500 block mb-1">{srv.data.tag}</span>
                      <span class="block text-xs font-bold text-slate-200 group-hover:text-cyan-300 transition-colors leading-snug">
                        {srv.data.title}
                      </span>
                    </a>
                  ))}
                </div>
              </div>

              <!-- ستون چپ: تمام ۱۰ استک سازمانی (/enterprise/) -->
              <div class="col-span-5 p-5 bg-[#050811] border-r border-slate-800/70 flex flex-col justify-between">
                <div>
                  <div class="text-[11px] font-mono text-emerald-400 uppercase tracking-wider mb-3">Enterprise Stacks (HA)</div>
                  <ul class="grid grid-cols-1 gap-1">
                    {allTools.map((tool) => (
                      <li>
                        <a
                          href={`/enterprise/${tool.id}/`}
                          class="flex items-center justify-between px-3 py-1.5 rounded-lg text-xs font-mono text-slate-300 hover:text-cyan-300 hover:bg-slate-900/80 focus-visible:bg-slate-900 outline-none transition-colors"
                        >
                          <span class="truncate">{tool.data.name}</span>
                          <span class="text-slate-600 shrink-0">←</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>

                <div class="pt-3 mt-3 border-t border-slate-800/80">
                  <a href="/enterprise/" class="block text-center text-xs font-bold py-2 rounded-lg bg-slate-900 hover:bg-slate-800 border border-slate-700 text-cyan-400 transition-colors">
                    مشاهده تمام {allTools.length} استک سازمانی ←
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>

        {navItems.map((item) => (
          <a
            href={item.href}
            class="nav-item px-3 py-2 text-sm font-medium text-slate-300 hover:text-cyan-400 rounded-lg transition-colors focus-visible:ring-2 focus-visible:ring-cyan-500 outline-none"
          >
            {item.name}
          </a>
        ))}
      </nav>

      <div class="flex items-center gap-3 relative z-10">
        <a
          href="/assessment/"
          class="relative hidden sm:inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl font-medium text-xs text-cyan-300 bg-cyan-950/40 border border-cyan-500/30 hover:border-cyan-400 hover:bg-cyan-500/20 hover:shadow-[0_0_20px_rgba(6,182,212,0.25)] transition-all overflow-hidden focus-visible:ring-2 focus-visible:ring-cyan-500 outline-none"
        >
          <span class="w-2 h-2 rounded-full bg-cyan-400 animate-ping"></span>
          <span>درخواست ارزیابی معماری</span>
        </a>

        <button
          id="mobile-menu-btn"
          type="button"
          class="lg:hidden p-2 rounded-xl border border-slate-700 bg-slate-900/80 text-slate-300 hover:text-white focus:outline-none"
          aria-label="باز کردن منو"
          aria-expanded="false"
        >
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- منوی موبایل -->
  <div id="mobile-menu" class="hidden lg:hidden fixed inset-x-0 top-20 bg-[#050811] border-b border-slate-800 max-h-[85vh] overflow-y-auto px-6 py-6 shadow-2xl z-[150]">
    <div class="flex flex-col gap-3">
      <div>
        <button id="mobile-services-toggle" type="button" class="flex items-center justify-between w-full text-sm font-medium text-slate-200 py-2 border-b border-slate-800/60 focus:outline-none">
          <span>خدمات تخصصی</span>
          <svg id="mobile-arrow" class="w-4 h-4 text-slate-400 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div id="mobile-services-list" class="hidden py-3 px-3 my-2 bg-slate-900/60 rounded-xl border border-slate-800/80 space-y-2">
          {sortedServices.map((srv) => (
            <a href={`/services/${srv.id}/`} class="mobile-link block text-xs text-slate-300 py-1.5 hover:text-cyan-300">
              {srv.data.title}
            </a>
          ))}
          <a href="/services/" class="mobile-link block text-center text-xs font-bold text-cyan-400 pt-3 border-t border-slate-800 mt-2">
            مشاهده کاتالوگ جامع سرویس‌ها ←
          </a>
        </div>
      </div>

      {navItems.map((item) => (
        <a href={item.href} class="mobile-link text-sm font-medium text-slate-200 py-2 border-b border-slate-800/60">
          {item.name}
        </a>
      ))}

      <a href="/assessment/" class="mt-4 text-center text-sm font-bold py-3.5 rounded-xl bg-cyan-500 hover:bg-cyan-400 text-slate-950 transition-colors shadow-lg shadow-cyan-500/25">
        ثبت درخواست بررسی معماری
      </a>
    </div>
  </div>
</header>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const mobileBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    mobileBtn?.addEventListener('click', () => {
      const isHidden = mobileMenu?.classList.toggle('hidden');
      mobileBtn.setAttribute('aria-expanded', String(!isHidden));
    });

    const servicesToggle = document.getElementById('mobile-services-toggle');
    const servicesList = document.getElementById('mobile-services-list');
    const arrow = document.getElementById('mobile-arrow');

    servicesToggle?.addEventListener('click', () => {
      servicesList?.classList.toggle('hidden');
      arrow?.classList.toggle('rotate-180');
    });

    const links = document.querySelectorAll('a.nav-item, a.mobile-link');
    links.forEach((link) => {
      link.addEventListener('click', (e) => {
        const href = link.getAttribute('href');
        if (href && href.startsWith('/#') && window.location.pathname === '/') {
          e.preventDefault();
          const targetId = href.substring(2);
          const targetEl = document.getElementById(targetId);
          if (targetEl) {
            targetEl.scrollIntoView({ behavior: 'smooth' });
            history.pushState(null, '', '#' + targetId);
            mobileMenu?.classList.add('hidden');
          }
        }
      });
    });
  });
</script>
