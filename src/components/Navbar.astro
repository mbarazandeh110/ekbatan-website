---
import { getCollection } from 'astro:content';

const allServices = await getCollection('services');
const sortedServices = allServices.sort((a, b) => a.data.order - b.data.order);

const servicesByCategory = sortedServices.reduce((acc, service) => {
  const tag = service.data.tag;
  if (!acc[tag]) acc[tag] = [];
  acc[tag].push(service);
  return acc;
}, {} as Record<string, any[]>);

const categories = Object.keys(servicesByCategory);

const navItems = [
  { name: "زیرساخت ابری", href: "/#infrastructure" },
  { name: "مدل‌های همکاری", href: "/#engagement" },
  { name: "مطالعات موردی", href: "/#track-record" },
  { name: "استک‌های سازمانی", href: "/#enterprise-stack" },
  { name: "بلاگ مهندسی", href: "/blog" },
  { name: "درباره ما", href: "/about" },
];

const MAX_SERVICES_PER_CATEGORY = 4;
---

<header class="sticky top-0 z-[100] backdrop-blur-xl bg-[#050811]/90 border-b border-slate-800 transition-all">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <a href="/" class="flex items-center gap-3.5 group focus:outline-none relative z-10">
        <div class="relative flex items-center justify-center w-11 h-11 rounded-xl bg-slate-900 border border-slate-700 group-hover:border-cyan-500/50 transition-colors shadow-inner">
          <picture>
            <source srcset="/Ekbatan_logo.webp" type="image/webp" />
            <img 
              src="/Ekbatan_logo.png" 
              alt="لوگوی شرکت اکباتان" 
              class="h-7 w-7 object-contain opacity-95 group-hover:scale-105 transition-transform" 
              width="28" 
              height="28" 
              loading="eager" 
              decoding="async"
            />
          </picture>
        </div>
        <div class="flex flex-col">
          <span class="text-lg font-black tracking-wider text-white font-mono leading-none group-hover:text-cyan-400 transition-colors">EKBATAN</span>
          <span class="text-[10px] font-mono text-cyan-400 tracking-[0.2em] uppercase mt-1">Cloud Systems</span>
        </div>
      </a>

      <nav class="hidden lg:flex items-center gap-1 xl:gap-2 relative z-10">
        <a href="/#infrastructure" class="nav-item px-3 py-2 text-sm font-medium text-slate-300 hover:text-cyan-400 rounded-lg transition-colors">
          زیرساخت ابری
        </a>

        <div class="relative group/menu py-5">
          <button class="nav-item flex items-center gap-1.5 px-3 py-2 text-sm font-medium text-slate-300 hover:text-cyan-400 rounded-lg transition-colors focus:outline-none">
            <span>خدمات تخصصی</span>
            <svg class="w-4 h-4 text-slate-500 transition-transform duration-300 group-hover/menu:rotate-180 group-hover/menu:text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>

          <div class="absolute top-[calc(100%-8px)] right-0 w-[calc(100vw-2rem)] lg:w-[850px] xl:w-[950px] bg-[#020617] border border-cyan-900/60 rounded-2xl shadow-[0_30px_60px_-10px_rgba(0,0,0,1)] opacity-0 invisible group-hover/menu:opacity-100 group-hover/menu:visible transition-all duration-300 translate-y-3 group-hover/menu:translate-y-0 z-[999] overflow-hidden flex flex-col before:absolute before:-top-2 before:right-[50px] before:w-4 before:h-4 before:bg-[#020617] before:border-t before:border-l before:border-cyan-900/60 before:rotate-45 before:z-20">
            
            <div class="flex items-center justify-between px-7 py-4 border-b border-slate-800 bg-[#020617] relative z-10 shrink-0">
              <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
                <span class="text-xs font-mono font-semibold tracking-wider text-slate-300 uppercase">Architecture & Deployment Catalog</span>
              </div>
              <a href="/services" class="text-xs font-semibold text-cyan-400 hover:text-cyan-300 flex items-center gap-1 transition-colors">
                کاتالوگ جامع
                <span class="font-mono">←</span>
              </a>
            </div>

            <!-- تغییر ارتفاع ثابت به مینیمم و ماکزیمم برای جلوگیری از فشردگی -->
            <div class="flex min-h-[450px] max-h-[70vh]">
              
              <div class="w-[30%] bg-[#050811] py-4 overflow-y-auto mega-menu-scrollbar shrink-0">
                <ul class="flex flex-col gap-1 pr-3 pl-0 relative">
                  <!-- خط مرزی عمودی یکپارچه در سمت چپ لیست -->
                  <div class="absolute top-0 bottom-0 left-0 w-px bg-slate-800/60"></div>
                  
                  {categories.map((category, index) => (
                    <li>
                      <button 
                        class={`category-tab w-full text-right flex items-center justify-between px-4 py-3.5 transition-all font-mono text-[11px] uppercase tracking-wide border-y border-r relative z-10 ${index === 0 ? 'bg-[#0B1221] text-cyan-400 border-slate-800/60 !border-l-0 rounded-r-xl rounded-l-none -ml-px' : 'bg-transparent text-slate-400 border-transparent hover:bg-slate-900/60 hover:text-slate-200 rounded-xl mr-2'}`}
                        data-target={`pane-${index}`}
                      >
                        <span class="truncate">{category}</span>
                        <svg class={`w-4 h-4 transition-transform ${index === 0 ? 'text-cyan-400' : 'text-slate-600 opacity-0 -translate-x-2'}`} fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                        </svg>
                      </button>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- رنگ پس‌زمینه پنل Detail هم‌رنگ با تب فعال تنظیم شد (#0B1221) -->
              <div class="w-[70%] relative bg-[#0B1221] overflow-hidden rounded-bl-2xl">
                {categories.map((category, index) => {
                  const services = servicesByCategory[category];
                  const displayServices = services.slice(0, 6); // نمایش هوشمند حداکثر ۶ کارت
                  const hasMore = services.length > 6;

                  return (
                    <div 
                      id={`pane-${index}`} 
                      class={`service-pane absolute inset-0 p-8 overflow-y-auto mega-menu-scrollbar transition-opacity duration-300 ${index === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0 pointer-events-none'}`}
                    >
                      <div class="text-lg font-bold text-white mb-6 border-b border-slate-800/80 pb-3 flex items-center justify-between">
                        <span class="bg-gradient-to-l from-white to-slate-400 bg-clip-text text-transparent">خدمات {category}</span>
                        <span class="text-xs font-mono text-cyan-400 bg-cyan-950/30 px-2 py-0.5 rounded border border-cyan-900/40">{services.length} Service(s)</span>
                      </div>
                      
                      <div class="grid grid-cols-2 gap-4">
                        {displayServices.map((srv) => (
                          <a 
                            href={`/services/${srv.id}`}
                            class="group block p-5 rounded-xl bg-[#070b14] border border-slate-800/80 hover:border-cyan-500/40 transition-all duration-300 shadow-sm hover:shadow-[0_4px_20px_-5px_rgba(6,182,212,0.15)] relative overflow-hidden"
                          >
                            <div class="absolute inset-0 bg-gradient-to-br from-cyan-500/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
                            <h4 class="relative z-10 text-sm font-bold text-slate-200 group-hover:text-cyan-300 transition-colors mb-2 leading-relaxed">{srv.data.title}</h4>
                            <p class="relative z-10 text-[11px] text-slate-500 line-clamp-2 leading-relaxed font-light">{srv.data.description}</p>
                          </a>
                        ))}
                      </div>

                      {hasMore && (
                        <div class="mt-6 pt-4 text-center">
                          <a href={`/services/category/${category}`} class="inline-block text-[13px] text-cyan-500 hover:text-cyan-400 font-bold transition-colors border-b border-dashed border-cyan-800 hover:border-cyan-400 pb-1">
                            مشاهده تمام {services.length} سرویس در این دسته →
                          </a>
                        </div>
                      )}
                    </div>
                  );
                })}
              </div>

            </div>
          </div>
        </div>

        {navItems.slice(1).map((item) => (
          <a href={item.href} class="nav-item px-3 py-2 text-sm font-medium text-slate-300 hover:text-cyan-400 rounded-lg transition-colors">
            {item.name}
          </a>
        ))}
      </nav>

      <div class="flex items-center gap-3 relative z-10">
        <a 
          href="/assessment" 
          class="relative hidden sm:inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl font-medium text-xs text-cyan-300 bg-cyan-950/40 border border-cyan-500/30 hover:border-cyan-400 hover:bg-cyan-500/20 hover:shadow-[0_0_20px_rgba(6,182,212,0.25)] transition-all overflow-hidden"
        >
          <span class="w-2 h-2 rounded-full bg-cyan-400 animate-ping"></span>
          <span>درخواست ارزیابی معماری</span>
        </a>

        <button 
          id="mobile-menu-btn" 
          class="lg:hidden p-2 rounded-xl border border-slate-700 bg-slate-900/80 text-slate-300 hover:text-white focus:outline-none"
          aria-label="باز کردن منو"
        >
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <div id="mobile-menu" class="hidden lg:hidden fixed inset-x-0 top-20 bg-[#050811] border-b border-slate-800 max-h-[85vh] overflow-y-auto px-6 py-6 shadow-2xl z-[150]">
    <div class="flex flex-col gap-3">
      <a href="/#infrastructure" class="mobile-link text-sm font-medium text-slate-200 py-2 border-b border-slate-800/60">زیرساخت ابری</a>
      
      <div>
        <button id="mobile-services-toggle" class="flex items-center justify-between w-full text-sm font-medium text-slate-200 py-2 border-b border-slate-800/60 focus:outline-none">
          <span>خدمات تخصصی</span>
          <svg id="mobile-arrow" class="w-4 h-4 text-slate-400 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div id="mobile-services-list" class="hidden py-3 px-3 my-2 bg-slate-900/60 rounded-xl border border-slate-800/80 space-y-6">
          {categories.map((category) => {
            const services = servicesByCategory[category];
            const displayServicesMobile = services.slice(0, 3);
            const hasMoreMobile = services.length > 3;

            return (
              <div>
                <div class="text-[10px] font-mono font-bold text-cyan-400 mb-2 uppercase">{category}</div>
                <ul class="space-y-2 pr-2 border-r border-slate-700">
                  {displayServicesMobile.map((srv) => (
                    <li>
                      <a href={`/services/${srv.id}`} class="mobile-link block text-xs text-slate-300 py-1 hover:text-cyan-300">
                        {srv.data.title}
                      </a>
                    </li>
                  ))}
                  {hasMoreMobile && (
                     <li>
                        <a href={`/services/category/${category}`} class="mobile-link block text-[11px] text-cyan-500/80 font-bold py-1 hover:text-cyan-300">
                          مشاهده همه {services.length} مورد...
                        </a>
                      </li>
                  )}
                </ul>
              </div>
            );
          })}
          <a href="/services" class="mobile-link block text-center text-xs font-bold text-cyan-400 pt-4 border-t border-slate-800 mt-4">مشاهده کاتالوگ جامع سرویس‌ها ←</a>
        </div>
      </div>

      {navItems.slice(1).map((item) => (
        <a href={item.href} class="mobile-link text-sm font-medium text-slate-200 py-2 border-b border-slate-800/60">
          {item.name}
        </a>
      ))}

      <a href="/assessment" class="mt-4 text-center text-sm font-bold py-3.5 rounded-xl bg-cyan-500 hover:bg-cyan-400 text-slate-950 transition-colors shadow-lg shadow-cyan-500/25">
        ثبت درخواست بررسی معماری
      </a>
    </div>
  </div>
</header>

<style>
  .mega-menu-scrollbar::-webkit-scrollbar { width: 4px; }
  .mega-menu-scrollbar::-webkit-scrollbar-track { background: transparent; }
  .mega-menu-scrollbar::-webkit-scrollbar-thumb { background-color: #1e293b; border-radius: 10px; }
  .mega-menu-scrollbar:hover::-webkit-scrollbar-thumb { background-color: #334155; }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const mobileBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    mobileBtn?.addEventListener('click', () => {
      mobileMenu?.classList.toggle('hidden');
    });

    const servicesToggle = document.getElementById('mobile-services-toggle');
    const servicesList = document.getElementById('mobile-services-list');
    const arrow = document.getElementById('mobile-arrow');

    servicesToggle?.addEventListener('click', () => {
      servicesList?.classList.toggle('hidden');
      arrow?.classList.toggle('rotate-180');
    });

    const links = document.querySelectorAll('a.nav-item, a.mobile-link');
    links.forEach(link => {
      link.addEventListener('click', (e) => {
        const href = link.getAttribute('href');
        if (href && href.startsWith('/#') && window.location.pathname === '/') {
          e.preventDefault();
          const targetId = href.substring(2);
          const targetEl = document.getElementById(targetId);
          if (targetEl) {
            targetEl.scrollIntoView({ behavior: 'smooth' });
            history.pushState(null, '', '#' + targetId);
            mobileMenu?.classList.add('hidden');
          }
        }
      });
    });

    const categoryTabs = document.querySelectorAll('.category-tab');
    const servicePanes = document.querySelectorAll('.service-pane');

    categoryTabs.forEach(tab => {
      tab.addEventListener('mouseenter', () => {
        categoryTabs.forEach(t => {
          t.classList.remove('bg-[#0B1221]', 'text-cyan-400', 'border-slate-800/60', '!border-l-0', 'rounded-r-xl', 'rounded-l-none', '-ml-px');
          t.classList.add('bg-transparent', 'text-slate-400', 'border-transparent', 'rounded-xl', 'mr-2');
          
          const icon = t.querySelector('svg');
          if(icon) {
            icon.classList.remove('text-cyan-400', 'opacity-100', 'translate-x-0');
            icon.classList.add('text-slate-600', 'opacity-0', '-translate-x-2');
          }
        });

        tab.classList.remove('bg-transparent', 'text-slate-400', 'border-transparent', 'rounded-xl', 'mr-2');
        tab.classList.add('bg-[#0B1221]', 'text-cyan-400', 'border-slate-800/60', '!border-l-0', 'rounded-r-xl', 'rounded-l-none', '-ml-px');
        
        const activeIcon = tab.querySelector('svg');
        if(activeIcon) {
          activeIcon.classList.remove('text-slate-600', 'opacity-0', '-translate-x-2');
          activeIcon.classList.add('text-cyan-400', 'opacity-100', 'translate-x-0');
        }

        servicePanes.forEach(pane => {
          pane.classList.remove('opacity-100', 'z-10');
          pane.classList.add('opacity-0', 'z-0', 'pointer-events-none');
        });

        const targetId = tab.getAttribute('data-target');
        const targetPane = document.getElementById(targetId || '');
        if(targetPane) {
          targetPane.classList.remove('opacity-0', 'z-0', 'pointer-events-none');
          targetPane.classList.add('opacity-100', 'z-10');
        }
      });
    });
  });
</script>