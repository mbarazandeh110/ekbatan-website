---
import { getCollection } from 'astro:content';

const allServices = await getCollection('services');
const sortedServices = allServices.sort((a, b) => a.data.order - b.data.order);

// گروه‌بندی ساختاریافته خدمات بر اساس تگ
const servicesByCategory = sortedServices.reduce((acc, service) => {
  const tag = service.data.tag;
  if (!acc[tag]) acc[tag] = [];
  acc[tag].push(service);
  return acc;
}, {} as Record<string, any[]>);

const navItems = [
  { name: "زیرساخت ابری", href: "/#infrastructure" },
  { name: "مدل‌های همکاری", href: "/#engagement" },
  { name: "مطالعات موردی", href: "/#track-record" },
  { name: "استک‌های سازمانی", href: "/#enterprise-stack" },
  { name: "بلاگ مهندسی", href: "/blog" },
  { name: "درباره ما", href: "/about" },
];
---

<header class="sticky top-0 z-50 backdrop-blur-xl bg-[#070b14]/90 border-b border-slate-800/80 transition-all">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- برند و لوگو -->
      <a href="/" class="flex items-center gap-3.5 group focus:outline-none">
        <div class="relative flex items-center justify-center w-11 h-11 rounded-xl bg-slate-900 border border-slate-800 group-hover:border-cyan-500/40 transition-colors shadow-inner">
          <picture>
            <source srcset="/Ekbatan_logo.webp" type="image/webp" />
            <img 
              src="/Ekbatan_logo.png" 
              alt="لوگوی شرکت اکباتان" 
              class="h-7 w-7 object-contain opacity-95 group-hover:scale-105 transition-transform" 
              width="28" 
              height="28" 
              loading="eager" 
              decoding="async"
            />
          </picture>
        </div>
        <div class="flex flex-col">
          <span class="text-lg font-black tracking-wider text-white font-mono leading-none group-hover:text-cyan-400 transition-colors">EKBATAN</span>
          <span class="text-[10px] font-mono text-cyan-400 tracking-[0.2em] uppercase mt-1">Cloud Systems</span>
        </div>
      </a>

      <!-- منوی دسکتاپ -->
      <nav class="hidden lg:flex items-center gap-1 xl:gap-2">
        <a href="/#infrastructure" class="nav-item px-3 py-2 text-sm font-medium text-slate-300 hover:text-cyan-400 rounded-lg transition-colors">
          زیرساخت ابری
        </a>

        <!-- مگا منوی شناور و شفاف خدمات -->
        <div class="relative group/menu py-5">
          <button class="nav-item flex items-center gap-1.5 px-3 py-2 text-sm font-medium text-slate-300 hover:text-cyan-400 rounded-lg transition-colors focus:outline-none">
            <span>خدمات تخصصی</span>
            <svg class="w-4 h-4 text-slate-500 transition-transform duration-300 group-hover/menu:rotate-180 group-hover/menu:text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>

          <!-- پنل مگا منو (بدون تداخل لایه‌ای و با Backdrop ایمن) -->
          <div class="absolute top-[80px] -right-20 w-[840px] bg-[#080d19]/98 backdrop-blur-2xl border border-slate-700/80 rounded-2xl shadow-[0_20px_60px_-15px_rgba(0,0,0,0.8),0_0_30px_rgba(6,182,212,0.12)] p-6 opacity-0 invisible group-hover/menu:opacity-100 group-hover/menu:visible transition-all duration-200 translate-y-3 group-hover/menu:translate-y-0 z-[100]">
            <div class="flex items-center justify-between pb-4 mb-5 border-b border-slate-800">
              <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
                <span class="text-xs font-mono font-semibold tracking-wider text-slate-300 uppercase">Architecture & Deployment Catalog</span>
              </div>
              <a href="/services" class="text-xs font-semibold text-cyan-400 hover:text-cyan-300 flex items-center gap-1 transition-colors">
                مشاهده همه سرویس‌ها
                <span class="font-mono">←</span>
              </a>
            </div>

            <div class="grid grid-cols-3 gap-6 max-h-[60vh] overflow-y-auto pl-2">
              {Object.entries(servicesByCategory).map(([category, services]) => (
                <div class="space-y-3">
                  <div class="flex items-center justify-between border-b border-slate-800/60 pb-2">
                    <span class="text-xs font-mono font-bold text-cyan-400 tracking-wide">{category}</span>
                  </div>
                  <ul class="space-y-1.5">
                    {services.map((srv) => (
                      <li>
                        <a 
                          href={`/services/${srv.id}`}
                          class="block px-2.5 py-1.5 text-xs text-slate-300 hover:text-white hover:bg-slate-800/70 rounded-md transition-all font-medium"
                        >
                          {srv.data.title}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </div>
        </div>

        {navItems.slice(1).map((item) => (
          <a href={item.href} class="nav-item px-3 py-2 text-sm font-medium text-slate-300 hover:text-cyan-400 rounded-lg transition-colors">
            {item.name}
          </a>
        ))}
      </nav>

      <!-- CTA و دکمه موبایل -->
      <div class="flex items-center gap-3">
        <a 
          href="/assessment" 
          class="relative inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl font-medium text-xs text-cyan-300 bg-cyan-950/50 border border-cyan-500/30 hover:border-cyan-400 hover:bg-cyan-500/15 hover:shadow-[0_0_20px_rgba(6,182,212,0.25)] transition-all overflow-hidden"
        >
          <span class="w-2 h-2 rounded-full bg-cyan-400 animate-ping"></span>
          <span>درخواست ارزیابی معماری</span>
        </a>

        <!-- دکمه منوی همبرگری موبایل -->
        <button 
          id="mobile-menu-btn" 
          class="lg:hidden p-2 rounded-xl border border-slate-800 bg-slate-900/80 text-slate-300 hover:text-white focus:outline-none"
          aria-label="باز کردن منو"
        >
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- منوی بازشونده موبایل -->
  <div id="mobile-menu" class="hidden lg:hidden fixed inset-x-0 top-20 bg-[#070b14]/98 border-b border-slate-800 backdrop-blur-2xl max-h-[85vh] overflow-y-auto px-6 py-6 shadow-2xl z-[150]">
    <div class="flex flex-col gap-3">
      <a href="/#infrastructure" class="mobile-link text-sm font-medium text-slate-200 py-2 border-b border-slate-800/60">زیرساخت ابری</a>
      
      <!-- آکاردئون موبایل -->
      <div>
        <button id="mobile-services-toggle" class="flex items-center justify-between w-full text-sm font-medium text-slate-200 py-2 border-b border-slate-800/60 focus:outline-none">
          <span>خدمات تخصصی</span>
          <svg id="mobile-arrow" class="w-4 h-4 text-slate-400 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div id="mobile-services-list" class="hidden py-3 px-3 my-2 bg-slate-900/60 rounded-xl border border-slate-800/80 space-y-4">
          {Object.entries(servicesByCategory).map(([category, services]) => (
            <div>
              <div class="text-[11px] font-mono text-cyan-400 mb-2">{category}</div>
              <ul class="space-y-1.5 pr-2 border-r border-slate-800">
                {services.map((srv) => (
                  <li>
                    <a href={`/services/${srv.id}`} class="mobile-link block text-xs text-slate-300 py-1 hover:text-cyan-300">
                      {srv.data.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
          <a href="/services" class="mobile-link block text-center text-xs font-bold text-cyan-400 pt-2 border-t border-slate-800">مشاهده کاتالوگ همه سرویس‌ها ←</a>
        </div>
      </div>

      {navItems.slice(1).map((item) => (
        <a href={item.href} class="mobile-link text-sm font-medium text-slate-200 py-2 border-b border-slate-800/60">
          {item.name}
        </a>
      ))}

      <a href="/assessment" class="mt-4 text-center text-sm font-bold py-3 rounded-xl bg-cyan-500 text-slate-950 shadow-lg shadow-cyan-500/25">
        ثبت درخواست بررسی معماری
      </a>
    </div>
  </div>
</header>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // باز و بسته شدن منوی موبایل
    const mobileBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    mobileBtn?.addEventListener('click', () => {
      mobileMenu?.classList.toggle('hidden');
    });

    // آکاردئون بخش خدمات موبایل
    const servicesToggle = document.getElementById('mobile-services-toggle');
    const servicesList = document.getElementById('mobile-services-list');
    const arrow = document.getElementById('mobile-arrow');

    servicesToggle?.addEventListener('click', () => {
      servicesList?.classList.toggle('hidden');
      arrow?.classList.toggle('rotate-180');
    });

    // اسکرول نرم برای لینک‌های داخلی
    const links = document.querySelectorAll('a.nav-item, a.mobile-link');
    links.forEach(link => {
      link.addEventListener('click', (e) => {
        const href = link.getAttribute('href');
        if (href && href.startsWith('/#') && window.location.pathname === '/') {
          e.preventDefault();
          const targetId = href.substring(2);
          const targetEl = document.getElementById(targetId);
          if (targetEl) {
            targetEl.scrollIntoView({ behavior: 'smooth' });
            history.pushState(null, '', '#' + targetId);
            mobileMenu?.classList.add('hidden');
          }
        }
      });
    });
  });
</script>