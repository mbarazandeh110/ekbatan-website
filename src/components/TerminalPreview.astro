---
---

<section id="architecture" class="py-20 px-6 max-w-5xl mx-auto">
  <div class="text-center mb-10">
    <span class="text-xs font-mono text-cyan-400 tracking-widest uppercase">SYSTEM ARCHITECTURE</span>
    <h2 class="text-2xl md:text-4xl font-extrabold text-white mt-2">زیرساخت اعلامی (Declarative) و شفاف</h2>
  </div>

  <div class="rounded-xl border border-slate-800 bg-[#0B101B] shadow-2xl overflow-hidden font-mono text-xs text-left" dir="ltr">
    <div class="px-4 py-3 bg-slate-900/90 border-b border-slate-800 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="w-3 h-3 rounded-full bg-red-500/80"></span>
        <span class="w-3 h-3 rounded-full bg-amber-500/80"></span>
        <span class="w-3 h-3 rounded-full bg-emerald-500/80"></span>
      </div>
      <span class="text-slate-400 text-[11px]">ekbatan-platform-state.yaml</span>
      <div class="text-slate-500 text-[11px]">Kubernetes v1.33.1</div>
    </div>

    <div class="p-6 overflow-x-auto leading-relaxed text-slate-300">
      <p><span class="text-cyan-400">apiVersion</span>: core.ekbatan.tech/v1alpha1</p>
      <p><span class="text-cyan-400">kind</span>: InfrastructureTopology</p>
      <p><span class="text-cyan-400">metadata</span>:</p>
      <p class="pl-4"><span class="text-cyan-400">name</span>: <span class="text-emerald-300">ekbatan-prod-cluster</span></p>
      <p><span class="text-cyan-400">spec</span>:</p>
      <p class="pl-4"><span class="text-cyan-400">compute</span>:</p>
      <p class="pl-8"><span class="text-cyan-400">orchestration</span>: <span class="text-amber-200">Kubernetes HA (3 Control Planes)</span></p>
      <p class="pl-8"><span class="text-cyan-400">ai_workloads</span>: <span class="text-amber-200">HPE ProLiant DL380a Gen11 / NVIDIA H200 NVL w/ NVLink</span></p>
      <p class="pl-4"><span class="text-cyan-400">networking_and_security</span>:</p>
      <p class="pl-8"><span class="text-cyan-400">cni</span>: <span class="text-amber-200">Cilium eBPF (v1.18.1) + Anycast BGP</span></p>
      <p class="pl-8"><span class="text-cyan-400">secrets_management</span>: <span class="text-amber-200">HashiCorp Vault w/ External Secrets Operator</span></p>
      <p class="pl-8"><span class="text-cyan-400">edge_ingress</span>: <span class="text-amber-200">Golang Custom Controller (mlb-controller) w/ Envoy xDS</span></p>
      <p class="pl-4"><span class="text-cyan-400">observability</span>:</p>
      <p class="pl-8"><span class="text-cyan-400">tracing_metrics</span>: <span class="text-amber-200">OpenTelemetry + VictoriaMetrics + Loki</span></p>
      <p class="pl-4"><span class="text-cyan-400">enterpriseOperators</span>:</p>
      <p class="pl-8">- <span class="text-slate-400">name</span>: <span class="text-indigo-300">altinity-clickhouse-operator</span> | <span class="text-slate-400">status</span>: <span class="text-emerald-400">Active</span></p>
      <p class="pl-8">- <span class="text-slate-400">name</span>: <span class="text-indigo-300">eck-operator</span> | <span class="text-slate-400">status</span>: <span class="text-emerald-400">Active</span></p>
      <p class="mt-4 text-emerald-400/80"># Cluster Status: Automated Node Remediation Active | Availability (SLA) >= 99.99% | Error Budget &lt; 52.56 mins/year</p>
    </div>
  </div>
</section>