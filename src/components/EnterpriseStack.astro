---
import { getCollection } from 'astro:content';
const tools = await getCollection('tools');
---

<section id="enterprise-stack" class="py-24 px-6 bg-slate-950/60 border-y border-slate-800/60 reveal">
  <div class="max-w-7xl mx-auto">
    <!-- هدینگ و توضیحات بخش که گم شده بود -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
      <div>
        <span class="text-xs font-mono text-cyan-400 tracking-widest uppercase">ENTERPRISE SOLUTIONS</span>
        <h2 class="text-3xl md:text-5xl font-extrabold text-white mt-2">استقرار نسخه‌های سازمانی (Enterprise)</h2>
        <p class="text-slate-400 mt-4 max-w-xl text-sm md:text-base leading-relaxed">
          نصب، سخت‌سازی امنیتی، پشتیبان‌گیری خودکار و کلاسترینگ پشته‌های کلیدی سازمانی روی کوبرنتیز و سرورهای فیزیکی. روی هر ابزار کلیک کنید تا جزئیات معماری را ببینید.
        </p>
      </div>
    </div>

    <!-- لیست کارت ابزارها -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {tools.map((tool) => (
        <a 
          href={`/enterprise/${tool.id}`.replace('//', '/')}
          class="p-5 rounded-xl bg-slate-900/60 border border-slate-800 hover:border-cyan-500/50 hover:bg-slate-950 transition-all flex flex-col justify-between group cursor-pointer shadow-lg"
        >
          <div>
            <div class="flex items-center justify-between gap-2 mb-2">
              <span class="text-xs font-mono text-cyan-400 bg-cyan-950/60 px-2 py-0.5 rounded border border-cyan-800/40">
                K8s / Machine
              </span>
              <span class="text-slate-500 group-hover:text-cyan-400 transition-colors font-mono">→</span>
            </div>
            <h4 class="text-base font-bold text-white font-mono mt-1 group-hover:text-cyan-200 transition-colors">{tool.data.name}</h4>
            <p class="text-xs text-slate-400 mt-2">{tool.data.category}</p>
          </div>
          <div class="mt-4 pt-3 border-t border-slate-800/60 flex items-center justify-between text-[11px] text-slate-400">
            <span>HA Architecture & Backup</span>
            <span class="text-cyan-400 font-mono">Detailed View</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
