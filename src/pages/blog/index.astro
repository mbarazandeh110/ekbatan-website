---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

// دریافت تمام مقالات بلاگ و مرتب‌سازی بر اساس تاریخ جدیدترین به قدیمی‌ترین
const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const title = "بلاگ مهندسی و فنی | اکباتان";
const description = "مقالات تخصصی تیم مهندسی اکباتان در حوزه زیرساخت ابری، کوبرنتیز، SRE، معماری نرم‌افزار و DevOps.";
---

<Layout title={title} description={description}>
  <Navbar />
  
  <main class="py-20 px-6 max-w-5xl mx-auto min-h-[70vh]">
    <div class="mb-16 text-center">
      <span class="text-xs font-mono text-cyan-400 tracking-widest uppercase">ENGINEERING BLOG</span>
      <h1 class="text-4xl md:text-5xl font-black text-white mt-4 mb-6">
        بلاگ مهندسی <span class="text-cyan-400">اکباتان</span>
      </h1>
      <p class="text-slate-400 text-lg max-w-2xl mx-auto leading-relaxed font-light">
        یادداشت‌های فنی، تجربیات معماری و بررسی عمیق چالش‌های زیرساختی در محیط‌های Production.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {sortedPosts.map((post) => {
        const formattedDate = new Intl.DateTimeFormat('fa-IR', { 
          year: 'numeric', 
          month: 'long', 
          day: 'numeric' 
        }).format(post.data.pubDate);

        return (
          <a 
            href={`/blog/${post.id}`.replace('//', '/')}
            class="group p-8 rounded-2xl bg-slate-900/50 border border-slate-800 hover:border-cyan-500/40 hover:bg-slate-950 transition-all flex flex-col justify-between shadow-lg"
          >
            <div>
              <div class="flex items-center gap-4 text-xs font-mono text-slate-400 mb-4">
                <time datetime={post.data.pubDate.toISOString()} class="text-cyan-400">{formattedDate}</time>
                <span>•</span>
                <span>{post.data.author}</span>
              </div>
              <h2 class="text-2xl font-bold text-white mb-4 group-hover:text-cyan-300 transition-colors leading-snug">
                {post.data.title}
              </h2>
              <p class="text-slate-400 text-sm leading-relaxed mb-6 font-light">
                {post.data.description}
              </p>
            </div>
            
            <div class="pt-4 border-t border-slate-800/60 flex items-center justify-between text-xs text-cyan-400">
              <span class="font-medium">مطالعه مقاله</span>
              <span class="font-mono group-hover:translate-x-[-4px] transition-transform">←</span>
            </div>
          </a>
        );
      })}
    </div>
  </main>

  <Footer />
</Layout>