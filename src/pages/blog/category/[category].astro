---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';

const slugify = (text) => text.toString().toLowerCase()
  .replace(/\s+/g, '-')
  .replace(/&/g, 'and')
  .replace(/[^\w\-]+/g, '')
  .replace(/\-\-+/g, '-');

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  // استخراج تمام تگ‌ها
  const uniqueTags = [...new Set(allPosts.map((post) => post.data.tags || []).flat())];

  return uniqueTags.map((tag) => {
    // فیلتر کردن مقالات مرتبط با هر تگ
    const filteredPosts = allPosts
      .filter((post) => post.data.tags?.includes(tag))
      .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
      
    return {
      params: { category: slugify(tag) },
      props: { posts: filteredPosts, allTags: uniqueTags, originalTag: tag },
    };
  });
}

const { category } = Astro.params;
const { posts, allTags, originalTag } = Astro.props;

const title = `مقالات دسته ${originalTag} | بلاگ اکباتان`;
const description = `لیست مقالات تخصصی مهندسی اکباتان در حوزه ${originalTag}.`;
---

<Layout title={title} description={description}>
  <Navbar />
  
  <main class="py-20 px-6 max-w-5xl mx-auto min-h-[70vh]">
    <div class="mb-12 text-center">
      <span class="text-xs font-mono text-cyan-400 tracking-widest uppercase">CATEGORY</span>
      <h1 class="text-4xl md:text-5xl font-black text-white mt-4 mb-6">
        مقالات حوزه <span class="text-cyan-400 font-mono">{originalTag}</span>
      </h1>
    </div>

    <!-- نوار دسته‌بندی‌ها -->
    <div class="flex flex-wrap items-center justify-center gap-3 mb-16">
      <a href="/blog/" class="px-5 py-2 rounded-full bg-slate-900 border border-slate-800 text-slate-300 hover:text-cyan-300 hover:border-cyan-800 transition-colors text-sm font-bold">همه مقالات</a>
      {allTags.map(tag => (
        <a 
          href={`/blog/category/${slugify(tag)}/`} 
          class={`px-5 py-2 rounded-full text-sm font-mono transition-colors ${
            tag === originalTag 
            ? 'bg-cyan-500 text-slate-950 font-bold shadow-lg shadow-cyan-500/20' 
            : 'bg-slate-900 border border-slate-800 text-slate-300 hover:text-cyan-300 hover:border-cyan-800'
          }`}
        >
          {tag}
        </a>
      ))}
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {posts.map((post) => {
        const formattedDate = new Intl.DateTimeFormat('fa-IR', { year: 'numeric', month: 'long', day: 'numeric' }).format(post.data.pubDate);
        return (
          <a href={`/blog/${post.id}/`.replace('//', '/')} class="group p-8 rounded-2xl bg-slate-900/50 border border-slate-800 hover:border-cyan-500/40 hover:bg-slate-950 transition-all flex flex-col justify-between shadow-lg">
            <div>
              <div class="flex items-center gap-4 text-xs font-mono text-slate-400 mb-4">
                <time datetime={post.data.pubDate.toISOString()} class="text-cyan-400">{formattedDate}</time>
                <span>•</span>
                <span>{post.data.author}</span>
              </div>
              <h2 class="text-2xl font-bold text-white mb-4 group-hover:text-cyan-300 transition-colors leading-snug">{post.data.title}</h2>
              <p class="text-slate-400 text-sm leading-relaxed mb-6 font-light">{post.data.description}</p>
            </div>
            <div class="pt-4 border-t border-slate-800/60 flex items-center justify-between text-xs text-cyan-400">
              <span class="font-medium">مطالعه مقاله</span>
              <span class="font-mono group-hover:translate-x-[-4px] transition-transform">←</span>
            </div>
          </a>
        );
      })}
    </div>
  </main>
  <Footer />
</Layout>