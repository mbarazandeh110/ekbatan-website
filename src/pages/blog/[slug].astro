---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { getTeamMemberBySlug } from '../../data/team';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );
  return posts.map((post) => ({
    params: { slug: post.id },
    props: {
      post,
      relatedPosts: posts.filter((p) => p.id !== post.id).slice(0, 2),
    },
  }));
}

const { post, relatedPosts } = Astro.props;
const { Content } = await render(post);
const data = post.data;

const authorMember = getTeamMemberBySlug(data.authorSlug);
const displayAuthorName = authorMember ? authorMember.name : data.author;

const formattedDate = new Intl.DateTimeFormat('fa-IR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(data.pubDate);

const formattedUpdatedDate = data.updatedDate
  ? new Intl.DateTimeFormat('fa-IR', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    }).format(data.updatedDate)
  : null;

const canonicalUrl = new URL(Astro.url.pathname.replace(/\/$/, '') + '/', Astro.site).href;
const modifiedIso = (data.updatedDate || data.pubDate).toISOString();

const authorSchema = authorMember
  ? {
      '@type': 'Person',
      '@id': `https://ekbatan.tech/about/#${authorMember.slug}`,
      name: authorMember.name,
      jobTitle: authorMember.headline,
      url: `https://ekbatan.tech/about/#${authorMember.slug}`,
      sameAs: [authorMember.linkedin],
      worksFor: { '@id': 'https://ekbatan.tech/#organization' },
    }
  : {
      '@type': 'Organization',
      '@id': 'https://ekbatan.tech/#organization',
      name: data.author,
      url: 'https://ekbatan.tech/about/',
    };
---

<Layout
  title={`${data.title} | بلاگ اکباتان تک`}
  description={data.description}
  type="article"
  publishedTime={data.pubDate.toISOString()}
  modifiedTime={modifiedIso}
  author={displayAuthorName}
>
  <Navbar />

  <main class="py-20 px-6 max-w-4xl mx-auto">
    <nav aria-label="Breadcrumb" class="mb-8 text-xs font-mono text-slate-400 flex items-center gap-2">
      <a href="/" class="hover:text-cyan-400 transition-colors">خانه</a>
      <span>/</span>
      <a href="/blog/" class="hover:text-cyan-400 transition-colors">بلاگ مهندسی</a>
      <span>/</span>
      <span class="text-cyan-400 truncate max-w-[220px] sm:max-w-md">{data.title}</span>
    </nav>

    <article>
      <header class="mb-12 border-b border-slate-800/60 pb-8">
        <div class="flex flex-wrap items-center gap-3 text-xs font-mono text-cyan-400 mb-6">
          <time datetime={data.pubDate.toISOString()}>{formattedDate}</time>
          {formattedUpdatedDate && (
            <>
              <span class="text-slate-600">•</span>
              <span class="text-emerald-400">بروزرسانی: {formattedUpdatedDate}</span>
            </>
          )}
          <span class="text-slate-600">•</span>
          {authorMember ? (
            <a href={`/about/#${authorMember.slug}`} class="text-slate-300 hover:text-cyan-300 transition-colors">
              {authorMember.name}
            </a>
          ) : (
            <span class="text-slate-400">{data.author}</span>
          )}
        </div>

        <h1 class="text-3xl md:text-5xl font-black text-white mb-6 leading-snug">
          {data.title}
        </h1>

        <p class="text-slate-300 text-lg leading-relaxed font-light">
          {data.description}
        </p>

        {data.tags && (
          <div class="flex flex-wrap gap-2 mt-6">
            {data.tags.map((tag) => (
              <a
                href={`/blog/?tag=${encodeURIComponent(tag)}`}
                class="px-3 py-1 rounded-full bg-slate-900 border border-slate-800 hover:border-cyan-500/50 text-slate-300 hover:text-cyan-300 text-xs font-mono transition-colors"
              >
                {tag}
              </a>
            ))}
          </div>
        )}
      </header>

      <div class="prose prose-invert prose-cyan max-w-none text-slate-300 leading-loose rtl">
        <Content />
      </div>
    </article>

    {authorMember && (
      <section aria-label="درباره نویسنده" class="mt-14 p-6 rounded-2xl bg-slate-900/50 border border-slate-800 flex flex-col sm:flex-row items-start sm:items-center gap-5">
        <div class={`w-14 h-14 rounded-xl border flex items-center justify-center font-black text-xl shrink-0 ${authorMember.colorClass}`}>
          {authorMember.initials}
        </div>
        <div class="flex-1">
          <div class="flex flex-wrap items-center gap-3">
            <a href={`/about/#${authorMember.slug}`} class="text-base font-bold text-white hover:text-cyan-300 transition-colors">
              {authorMember.name}
            </a>
            <span class="text-[11px] font-mono text-cyan-400">{authorMember.headline}</span>
          </div>
          <p class="text-xs text-slate-400 leading-relaxed mt-2">{authorMember.bio}</p>
          <div class="mt-3 flex items-center gap-4 text-xs">
            <a href={authorMember.linkedin} target="_blank" rel="noopener noreferrer" class="text-cyan-400 hover:text-cyan-300 font-medium">
              پروفایل لینکدین ↗
            </a>
            <a href="/about/" class="text-slate-400 hover:text-slate-200">
              تیم مهندسی اکباتان ←
            </a>
          </div>
        </div>
      </section>
    )}

    <div class="p-8 md:p-10 rounded-3xl bg-gradient-to-r from-slate-900 via-slate-900/80 to-cyan-950/30 border border-cyan-900/40 text-center text-white my-16">
      <h2 class="text-xl md:text-2xl font-bold mb-3">نیاز به طراحی یا بهینه‌سازی زیرساخت Production دارید؟</h2>
      <p class="text-slate-300 text-sm mb-6 max-w-2xl mx-auto leading-relaxed">
        تیم مهندسی پلتفرم و SRE شرکت اکباتان آماده ممیزی گلوگاه‌های شبکه، استوریج و کلاسترهای کوبرنتیز سازمان شماست.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/assessment/" class="px-6 py-3 rounded-xl bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold text-sm transition-all shadow-lg shadow-cyan-500/25">
          درخواست ارزیابی معماری زیرساخت ←
        </a>
        <a href="/services/" class="px-6 py-3 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-medium text-sm transition-all border border-slate-700">
          مشاهده خدمات مهندسی
        </a>
      </div>
    </div>

    {relatedPosts && relatedPosts.length > 0 && (
      <section class="pt-12 border-t border-slate-800/60">
        <h2 class="text-2xl font-bold text-white mb-6">مقالات فنی مرتبط</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {relatedPosts.map((rel) => (
            <a
              href={`/blog/${rel.id}/`}
              class="p-6 rounded-2xl bg-slate-900/50 border border-slate-800 hover:border-cyan-500/40 transition-all flex flex-col justify-between group"
            >
              <div>
                <h3 class="text-lg font-bold text-white group-hover:text-cyan-300 transition-colors mb-2 leading-snug">
                  {rel.data.title}
                </h3>
                <p class="text-xs text-slate-400 leading-relaxed line-clamp-2">{rel.data.description}</p>
              </div>
              <span class="text-xs text-cyan-400 font-mono mt-4 inline-block">مطالعه مقاله ←</span>
            </a>
          ))}
        </div>
      </section>
    )}
  </main>

  <Footer />

  <script
    type="application/ld+json"
    set:html={JSON.stringify([
      {
        '@context': 'https://schema.org',
        '@type': 'TechArticle',
        mainEntityOfPage: {
          '@type': 'WebPage',
          '@id': canonicalUrl,
        },
        url: canonicalUrl,
        headline: data.title,
        description: data.description,
        image: 'https://ekbatan.tech/og-default.png',
        inLanguage: 'fa-IR',
        datePublished: data.pubDate.toISOString(),
        dateModified: modifiedIso,
        author: authorSchema,
        publisher: {
          '@id': 'https://ekbatan.tech/#organization',
          '@type': 'Organization',
          name: 'اکباتان تک (Ekbatan Tech)',
          logo: {
            '@type': 'ImageObject',
            url: 'https://ekbatan.tech/Ekbatan_logo.png',
          },
        },
      },
      {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'خانه', item: 'https://ekbatan.tech/' },
          { '@type': 'ListItem', position: 2, name: 'بلاگ مهندسی', item: 'https://ekbatan.tech/blog/' },
          { '@type': 'ListItem', position: 3, name: data.title, item: canonicalUrl },
        ],
      },
    ])}
  />
</Layout>