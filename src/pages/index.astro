---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import CoreCompetencies from '../components/CoreCompetencies.astro';
import EngagementModels from '../components/EngagementModels.astro';
import TrackRecord from '../components/TrackRecord.astro';
import EnterpriseStack from '../components/EnterpriseStack.astro';
import TerminalPreview from '../components/TerminalPreview.astro';
import Cta from '../components/Cta.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="شرکت اکباتان | مشاوره و استقرار زیرساخت ابری و کوبرنتیز"
  description="شرکت اکباتان؛ ارائه خدمات مشاوره، طراحی معماری و استقرار زیرساخت ابری، کلاسترهای کوبرنتیز سازمانی، Ceph، MLOps و خدمات SRE با تضمین پایداری ۹۹.۹۶٪."
>
  <Navbar />
  <main>
    <Hero />
    <CoreCompetencies />
    <EngagementModels />
    <TrackRecord />
    <EnterpriseStack />
    <TerminalPreview />
    <Cta />
  </main>
  <Footer />
  
  <!-- Schema Markup for Homepage -->
  <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ProfessionalService",
      "name": "Ekbatan Tech",
      "alternateName": ["شرکت اکباتان", "تیم مهندسی زیرساخت اکباتان"],
      "url": "https://ekbatan.tech",
      "logo": "https://ekbatan.tech/Ekbatan_logo.png",
      "description": "معماری زیرساخت‌های ابری، MLOps، دیتابیس‌های توزیع‌شده و کلاسترهای Enterprise Kubernetes توسط متخصصین DevOps و SRE.",
      "sameAs": ["https://linkedin.com/company/ekbatantech"],
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "تهران",
        "addressCountry": "IR"
      }
  })} />
</Layout>