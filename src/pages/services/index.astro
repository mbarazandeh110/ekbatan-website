---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const title = "خدمات مشاوره، استقرار و معماری زیرساخت سازمانی | اکباتان";
const description = "کاتالوگ خدمات مهندسی اکباتان شامل استقرار کوبرنتیز، ذخیره‌سازی توزیع‌شده (Ceph)، دیتابیس‌های کلان‌داده (ClickHouse) و خدمات SRE.";
const currentUrl = Astro.url.href;

// خواندن تمام سرویس‌ها از مارک‌داون و مرتب‌سازی بر اساس فیلد order
const allServices = await getCollection('services');
const sortedServices = allServices.sort((a, b) => a.data.order - b.data.order);

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "itemListElement": sortedServices.map((service, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "url": new URL(`/services/${service.id}`, currentUrl).href,
      "name": service.data.title
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "خانه", "item": "https://ekbatan.tech/" },
      { "@type": "ListItem", "position": 2, "name": "سرویس‌های سازمانی", "item": currentUrl }
    ]
  }
];
---

<Layout title={title} description={description}>
  <Navbar />
  
  <main class="py-20 px-6 max-w-5xl mx-auto min-h-[70vh]">
    <div class="mb-16 text-center">
      <span class="text-xs font-mono text-cyan-400 tracking-widest uppercase">OUR SERVICES</span>
      <h1 class="text-4xl md:text-5xl font-black text-white mt-4 mb-6">
        خدمات استقرار و <span class="text-cyan-400">معماری زیرساخت</span>
      </h1>
      <p class="text-slate-400 text-lg max-w-2xl mx-auto leading-relaxed font-light">
        ما فناوری‌های توزیع‌شده را برای حل چالش‌های واقعی کسب‌وکارها در مقیاس بالا، با رویکرد مهندسی قابلیت اطمینان (SRE) پیاده‌سازی می‌کنیم.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {sortedServices.map((service) => (
        <a 
          href={`/services/${service.id}`.replace('//', '/')}
          class="group p-8 rounded-2xl border transition-all flex flex-col justify-between bg-slate-900/50 border-slate-800 hover:border-cyan-500/40 hover:bg-slate-950 shadow-lg cursor-pointer"
        >
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-[10px] font-mono text-cyan-400 tracking-wider bg-cyan-950/40 px-2 py-1 rounded border border-cyan-900/40">
                {service.data.tag}
              </span>
            </div>
            <h2 class="text-xl font-bold mb-3 transition-colors text-white group-hover:text-cyan-300">
              {service.data.title}
            </h2>
            <p class="text-slate-400 text-sm leading-relaxed mb-6 font-light">
              {service.data.description}
            </p>
          </div>
          
          <div class="pt-4 border-t border-slate-800/60 flex items-center justify-between text-xs text-cyan-400">
            <span class="font-medium">بررسی جزئیات سرویس</span>
            <span class="font-mono group-hover:translate-x-[-4px] transition-transform">←</span>
          </div>
        </a>
      ))}
    </div>

    <div class="mt-20 p-10 rounded-3xl bg-gradient-to-r from-slate-900 via-slate-900/80 to-cyan-950/30 border border-cyan-900/40 text-center text-white">
      نیاز به ترکیب چند تکنولوژی برای معماری خاص خود دارید؟
      <div class="mt-6">
        <a 
          href="/assessment"
          class="inline-flex items-center gap-2 px-8 py-3.5 rounded-xl bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold text-sm transition-all shadow-lg shadow-cyan-500/25"
        >
          طراحی معماری اختصاصی (Discovery)
          <span>↗</span>
        </a>
      </div>
    </div>
  </main>

  <Footer />
  <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
</Layout>
