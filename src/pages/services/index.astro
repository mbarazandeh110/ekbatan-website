---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const title = 'خدمات مشاوره، استقرار و معماری زیرساخت سازمانی | اکباتان تک';
const description =
  'کاتالوگ جامع خدمات مهندسی شرکت اکباتان شامل استقرار کوبرنتیز سازمانی، ذخیره‌سازی توزیع‌شده (Ceph)، دیتابیس‌های کلان‌داده (ClickHouse & PostgreSQL)، کلاسترهای هوش مصنوعی (MLOps) و خدمات SRE.';

const allServices = await getCollection('services');
const sortedServices = allServices.sort((a, b) => a.data.order - b.data.order);
const uniqueCategories = [...new Set(sortedServices.map((service) => service.data.tag))];

const schemaData = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    itemListElement: sortedServices.map((service, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: `https://ekbatan.tech/services/${service.id}/`,
      name: service.data.title,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'خانه', item: 'https://ekbatan.tech/' },
      { '@type': 'ListItem', position: 2, name: 'خدمات مهندسی زیرساخت', item: 'https://ekbatan.tech/services/' },
    ],
  },
];
---

<Layout title={title} description={description}>
  <Navbar />

  <main class="py-20 px-6 max-w-5xl mx-auto min-h-[70vh]">
    <nav aria-label="Breadcrumb" class="mb-8 text-xs font-mono text-slate-400 flex items-center justify-center gap-2">
      <a href="/" class="hover:text-cyan-400 transition-colors">خانه</a>
      <span>/</span>
      <span class="text-cyan-400">خدمات مهندسی</span>
    </nav>

    <div class="mb-12 text-center">
      <span class="text-xs font-mono text-cyan-400 tracking-widest uppercase">OUR SERVICES</span>
      <h1 class="text-4xl md:text-5xl font-black text-white mt-4 mb-6">
        خدمات استقرار و <span class="text-cyan-400">معماری زیرساخت</span>
      </h1>
      <p class="text-slate-400 text-lg max-w-2xl mx-auto leading-relaxed font-light">
        ما در شرکت اکباتان فناوری‌های توزیع‌شده را برای حل چالش‌های واقعی کسب‌وکارها در مقیاس بالا، با رویکرد مهندسی قابلیت اطمینان (SRE) و پایداری ۹۹.۹۶٪ پیاده‌سازی می‌کنیم.
      </p>
    </div>

    <!-- فیلتر سمت کلاینت بدون ایجاد URLهای noindex اضافه -->
    <div class="flex flex-wrap items-center justify-center gap-2.5 mb-14" id="service-filters">
      <button
        type="button"
        data-filter="ALL"
        class="service-filter-btn px-4 py-2 rounded-full bg-cyan-500 text-slate-950 font-bold text-xs shadow-lg shadow-cyan-500/20 transition-all cursor-pointer"
      >
        تمام سرویس‌ها
      </button>
      {uniqueCategories.map((category) => (
        <button
          type="button"
          data-filter={category}
          class="service-filter-btn px-4 py-2 rounded-full bg-slate-900 border border-slate-800 text-slate-300 hover:text-cyan-300 hover:border-cyan-800 transition-all text-xs font-mono cursor-pointer"
        >
          {category}
        </button>
      ))}
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6" id="services-grid">
      {sortedServices.map((service) => (
        <a
          href={`/services/${service.id}/`}
          data-category={service.data.tag}
          class="service-card group p-8 rounded-2xl border transition-all flex flex-col justify-between bg-slate-900/50 border-slate-800 hover:border-cyan-500/40 hover:bg-slate-950 shadow-lg cursor-pointer"
        >
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-[10px] font-mono text-cyan-400 tracking-wider bg-cyan-950/40 px-2 py-1 rounded border border-cyan-900/40">
                {service.data.tag}
              </span>
            </div>
            <h2 class="text-xl font-bold mb-3 transition-colors text-white group-hover:text-cyan-300">
              {service.data.title}
            </h2>
            <p class="text-slate-400 text-sm leading-relaxed mb-6 font-light">
              {service.data.description}
            </p>
          </div>
          <div class="pt-4 border-t border-slate-800/60 flex items-center justify-between text-xs text-cyan-400">
            <span class="font-medium">بررسی معماری و جزئیات سرویس</span>
            <span class="font-mono group-hover:translate-x-[-4px] transition-transform">←</span>
          </div>
        </a>
      ))}
    </div>

    <div class="mt-16 p-8 rounded-2xl bg-slate-900/40 border border-slate-800 flex flex-col md:flex-row items-center justify-between gap-6">
      <div>
        <h2 class="text-lg font-bold text-white mb-2">به دنبال استقرار ابزارهای سازمانی خاص (GitLab، Jira، ECK، n8n) هستید؟</h2>
        <p class="text-slate-400 text-sm">معماری مرجع و فایل‌های پیکربندی HA تمام ۱۰ پشته سازمانی را در کاتالوگ اختصاصی ببینید.</p>
      </div>
      <a
        href="/enterprise/"
        class="px-6 py-3 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-700 text-cyan-300 font-bold text-sm transition-colors shrink-0"
      >
        مشاهده استک‌های سازمانی ←
      </a>
    </div>

    <div class="mt-12 p-10 rounded-3xl bg-gradient-to-r from-slate-900 via-slate-900/80 to-cyan-950/30 border border-cyan-900/40 text-center text-white">
      نیاز به ترکیب چند تکنولوژی برای معماری خاص خود دارید؟
      <div class="mt-6">
        <a href="/assessment/" class="inline-flex items-center gap-2 px-8 py-3.5 rounded-xl bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold text-sm transition-all shadow-lg shadow-cyan-500/25">
          طراحی معماری اختصاصی (Discovery)
          <span>↗</span>
        </a>
      </div>
    </div>
  </main>

  <Footer />
  <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('.service-filter-btn'));
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.service-card'));

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.dataset.filter || 'ALL';

        buttons.forEach((b) => {
          const isActive = b === btn;
          b.classList.toggle('bg-cyan-500', isActive);
          b.classList.toggle('text-slate-950', isActive);
          b.classList.toggle('font-bold', isActive);
          b.classList.toggle('shadow-lg', isActive);
          b.classList.toggle('bg-slate-900', !isActive);
          b.classList.toggle('border', !isActive);
          b.classList.toggle('border-slate-800', !isActive);
          b.classList.toggle('text-slate-300', !isActive);
        });

        cards.forEach((card) => {
          const match = filter === 'ALL' || card.dataset.category === filter;
          card.classList.toggle('hidden', !match);
        });
      });
    });
  });
</script>