---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const experiences = (await getCollection('experiences')).sort((a, b) =>
  a.id.localeCompare(b.id)
);

const title = 'مطالعات موردی و تجربیات مهندسی زیرساخت | اکباتان تک';
const description =
  'بررسی معماری و متریک‌های واقعی پروژه‌های اجرایی اکباتان تک در مقیاس ملی: کلاستر ۸۰+ نودی کوبرنتیز، CDN ترابیتی، استوریج پتابایتی Ceph و کلاسترهای GPU/AI.';

const schemaData = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'مطالعات موردی و تجربیات مهندسی اکباتان تک',
    itemListElement: experiences.map((exp, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: `https://ekbatan.tech/experience/${exp.id}/`,
      name: exp.data.title,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'خانه', item: 'https://ekbatan.tech/' },
      { '@type': 'ListItem', position: 2, name: 'مطالعات موردی و تجربیات', item: 'https://ekbatan.tech/experience/' },
    ],
  },
];
---

<Layout title={title} description={description}>
  <Navbar />

  <main class="py-20 px-6 max-w-6xl mx-auto min-h-[70vh]">
    <nav aria-label="Breadcrumb" class="mb-8 text-xs font-mono text-slate-400 flex items-center justify-center gap-2">
      <a href="/" class="hover:text-cyan-400 transition-colors">خانه</a>
      <span>/</span>
      <span class="text-cyan-400">مطالعات موردی و تجربیات</span>
    </nav>

    <div class="mb-14 text-center">
      <span class="text-xs font-mono text-cyan-400 tracking-widest uppercase">TRACK RECORD &amp; CASE STUDIES</span>
      <h1 class="text-3xl md:text-5xl font-black text-white mt-4 mb-6">
        مطالعات موردی و <span class="text-cyan-400">تجربیات اجرایی اکباتان</span>
      </h1>
      <p class="text-slate-400 text-base md:text-lg max-w-3xl mx-auto leading-relaxed font-light">
        گزارش‌های معماری، چالش‌های واقعی و متریک‌های پایداری به دست آمده در استقرار زیرساخت‌های پرترافیک و ماموریت‌بحرانی.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {experiences.map((exp) => (
        <a
          href={`/experience/${exp.id}/`}
          class="p-7 rounded-2xl bg-slate-900/60 border border-slate-800 hover:border-cyan-500/40 hover:bg-slate-950 transition-all flex flex-col justify-between group shadow-lg"
        >
          <div>
            <div class="flex items-center justify-between gap-2 mb-4">
              <span class="px-3 py-1 rounded-full bg-cyan-950/60 border border-cyan-800/40 text-cyan-300 font-mono text-[11px]">
                {exp.data.scale}
              </span>
              <span class="text-slate-500 group-hover:text-cyan-400 transition-colors font-mono">←</span>
            </div>
            <h2 class="text-lg font-bold text-white mb-3 group-hover:text-cyan-200 transition-colors leading-snug">
              {exp.data.title}
            </h2>
            <p class="text-slate-400 text-sm leading-relaxed mb-6">
              {exp.data.description}
            </p>
          </div>
          <div class="flex flex-wrap gap-1.5 pt-4 border-t border-slate-800/60">
            {exp.data.techs.slice(0, 6).map((tech: string) => (
              <span class="text-[10px] font-mono text-slate-300 bg-slate-800/80 px-2 py-0.5 rounded">
                {tech}
              </span>
            ))}
          </div>
        </a>
      ))}
    </div>

    <div class="mt-20 p-10 rounded-3xl bg-gradient-to-r from-slate-900 via-slate-900/80 to-cyan-950/30 border border-cyan-900/40 text-center text-white">
      <h2 class="text-xl md:text-2xl font-bold mb-3">چالش مقیاس‌پذیری مشابهی در زیرساخت خود دارید؟</h2>
      <p class="text-slate-300 text-sm max-w-2xl mx-auto mb-6 leading-relaxed">
        تیم SRE و پلتفرم اکباتان آماده بررسی معماری فعلی و طراحی مسیر مهاجرت امن شماست.
      </p>
      <a
        href="/assessment/"
        class="inline-flex items-center gap-2 px-8 py-3.5 rounded-xl bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold text-sm transition-all shadow-lg shadow-cyan-500/25"
      >
        درخواست ارزیابی معماری (Assessment)
        <span>↗</span>
      </a>
    </div>
  </main>

  <Footer />
  <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
</Layout>