---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const experiences = await getCollection('experiences');
  return experiences.map((exp) => ({
    params: { slug: exp.id },
    props: {
      exp,
      otherExperiences: experiences.filter((e) => e.id !== exp.id).slice(0, 3),
    },
  }));
}

const { exp, otherExperiences } = Astro.props;
const { Content } = await render(exp);
const data = exp.data;

const canonicalUrl = new URL(Astro.url.pathname.replace(/\/$/, '') + '/', Astro.site).href;

const truncateDescription = (text: string, maxLength = 155) => {
  if (text.length <= maxLength) return text;
  return text.substring(0, maxLength).replace(/\s+\S*$/, '') + '...';
};

const optimizedDescription = truncateDescription(data.description);
---

<Layout 
  title={`${data.title} | تجربیات اجرایی شرکت اکباتان`}
  description={optimizedDescription}
>
  <Navbar />
  
  <main class="py-20 px-6 max-w-5xl mx-auto">
    <nav aria-label="Breadcrumb" class="mb-8 text-xs font-mono text-slate-400 flex items-center gap-2">
      <a href="/" class="hover:text-cyan-400 transition-colors">خانه</a>
      <span>/</span>
      <a href="/services/" class="hover:text-cyan-400 transition-colors">خدمات و مطالعات موردی</a>
      <span>/</span>
      <span class="text-cyan-400 truncate max-w-[220px] sm:max-w-md">{data.title}</span>
    </nav>

    <div class="mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-cyan-800/60 bg-cyan-950/40 text-xs font-mono text-cyan-400 mb-6">
        <span>{data.category}</span>
        <span>•</span>
        <span class="text-emerald-400">{data.scale}</span>
      </div>
      <h1 class="text-3xl md:text-5xl font-black text-white mb-6 leading-snug">
        {data.title}
      </h1>
      <p class="text-slate-300 text-base md:text-lg leading-relaxed max-w-3xl font-light">
        {data.description}
      </p>
    </div>

    {data.metrics && data.metrics.length > 0 && (
      <div class="p-8 rounded-2xl bg-cyan-900/10 border border-cyan-800/40 mb-12">
        <h2 class="text-lg font-bold text-white mb-6 font-mono text-cyan-400">نتایج کمی و مقیاس عملیاتی (Impact & Metrics)</h2>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          {data.metrics.map((metric: any) => (
            <div class="p-4 bg-slate-900/50 rounded-xl border border-slate-800/80 text-center shadow-inner">
              <div class="text-2xl md:text-3xl font-black text-white mb-1 font-mono">{metric.value}</div>
              <div class="text-xs md:text-sm text-slate-400">{metric.label}</div>
            </div>
          ))}
        </div>
      </div>
    )}

    <div class="p-8 rounded-2xl bg-slate-900/50 border border-slate-800 mb-16">
      <h2 class="text-lg font-bold text-white mb-4 font-mono text-cyan-400">معماری و دستاوردهای کلیدی</h2>
      <ul class="space-y-3 text-slate-300 text-sm">
        {data.highlights.map((item: string) => (
          <li class="flex items-start gap-2">
            <span class="text-cyan-400 mt-1">✓</span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="mb-16">
      <h2 class="text-xl font-bold text-white mb-4">فناوری‌ها و پشته‌های فنی</h2>
      <div class="flex flex-wrap gap-2">
        {data.techs.map((tech: string) => (
          <span class="px-3 py-1.5 rounded-lg bg-slate-900 border border-slate-800 text-cyan-300 font-mono text-xs">
            {tech}
          </span>
        ))}
      </div>
    </div>

    <div class="text-slate-300 mb-16 prose prose-invert prose-cyan max-w-none leading-loose">
      <Content />
    </div>

    <div class="p-10 rounded-3xl bg-gradient-to-r from-slate-900 via-slate-900/80 to-cyan-950/30 border border-cyan-900/40 text-center text-white mb-16">
      برای پیاده‌سازی چنین مقیاس و معماری در سازمان خود با تیم SRE شرکت اکباتان مشورت کنید.
      <div class="mt-6">
        <a 
          href="/assessment/"
          class="inline-flex items-center gap-2 px-8 py-3.5 rounded-xl bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold text-sm transition-all shadow-lg shadow-cyan-500/25"
        >
          شروع ارزیابی زیرساخت (Assessment)
          <span>↗</span>
        </a>
      </div>
    </div>

    {otherExperiences && otherExperiences.length > 0 && (
      <section class="pt-12 border-t border-slate-800/60">
        <h2 class="text-xl font-bold text-white mb-6">سایر تجربیات و مقیاس‌های مهندسی اکباتان</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          {otherExperiences.map((item) => (
            <a
              href={`/experience/${item.id}/`}
              class="p-5 rounded-xl bg-slate-900/40 border border-slate-800 hover:border-cyan-500/40 transition-all flex flex-col justify-between group"
            >
              <div>
                <span class="text-[10px] font-mono text-cyan-400 block mb-2">{item.data.scale}</span>
                <h3 class="text-sm font-bold text-white group-hover:text-cyan-300 transition-colors leading-snug">
                  {item.data.title}
                </h3>
              </div>
              <span class="text-xs text-cyan-400 font-mono mt-4 inline-block">مشاهده جزئیات ←</span>
            </a>
          ))}
        </div>
      </section>
    )}
  </main>

  <Footer />
  
  <script type="application/ld+json" set:html={JSON.stringify([
    {
      "@context": "https://schema.org",
      "@type": "TechArticle",
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": canonicalUrl
      },
      "url": canonicalUrl,
      "headline": data.title,
      "description": optimizedDescription,
      "author": {
        "@type": "Organization",
        "name": "شرکت اکباتان (Ekbatan Tech)",
        "url": "https://ekbatan.tech/"
      },
      "publisher": {
        "@type": "Organization",
        "name": "شرکت اکباتان (Ekbatan Tech)",
        "logo": {
          "@type": "ImageObject",
          "url": "https://ekbatan.tech/Ekbatan_logo.png"
        }
      }
    },
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "خانه", "item": "https://ekbatan.tech/" },
        { "@type": "ListItem", "position": 2, "name": "خدمات سازمانی", "item": "https://ekbatan.tech/services/" },
        { "@type": "ListItem", "position": 3, "name": data.title, "item": canonicalUrl }
      ]
    }
  ])} />
</Layout>