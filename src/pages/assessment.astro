---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const schemaData = [
  {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    name: 'ارزیابی آمادگی زیرساخت و معماری ابری | اکباتان تک',
    url: 'https://ekbatan.tech/assessment/',
    mainEntity: { '@id': 'https://ekbatan.tech/#organization' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'خانه', item: 'https://ekbatan.tech/' },
      { '@type': 'ListItem', position: 2, name: 'ارزیابی معماری زیرساخت', item: 'https://ekbatan.tech/assessment/' },
    ],
  },
];
---

<Layout
  title="درخواست ارزیابی معماری زیرساخت و کوبرنتیز | اکباتان تک"
  description="فرم درخواست ارزیابی معماری ابری و کوبرنتیز برای محیط‌های Production. با تیم SRE اکباتان برای مقیاس‌پذیری و آمادگی زیرساخت مشورت کنید."
>
  <Navbar />
  <main class="min-h-screen bg-[#020617] py-20 px-6">
    <div class="max-w-3xl mx-auto">
      <nav aria-label="Breadcrumb" class="mb-8 text-xs font-mono text-slate-400 flex items-center justify-center gap-2">
        <a href="/" class="hover:text-cyan-400 transition-colors">خانه</a>
        <span>/</span>
        <span class="text-cyan-400">ارزیابی معماری</span>
      </nav>

      <div class="mb-10 text-center">
        <span class="text-xs font-mono text-cyan-400 tracking-widest uppercase">Production Readiness Assessment</span>
        <h1 class="text-3xl md:text-5xl font-black text-white mt-4 mb-4">ارزیابی آمادگی زیرساخت برای محیط‌های Production</h1>
        <p class="text-slate-400 text-sm md:text-base leading-relaxed">
          راه‌اندازی سیستم‌های مقیاس‌پذیر نیازمند طراحی دقیق Control Plane، شبکه و Storage است. نیازمندی‌های فنی خود را وارد کنید تا تیم SRE اکباتان جهت تدوین طرح معماری و ارزیابی آمادگی (Readiness) با شما تماس بگیرد.
        </p>
      </div>

      <div class="bg-slate-900/60 border border-slate-800 rounded-2xl p-8 shadow-2xl relative">
        <div id="success-message" class="hidden absolute inset-0 bg-slate-900/95 rounded-2xl flex flex-col items-center justify-center p-8 text-center z-10 backdrop-blur-sm">
          <svg class="w-16 h-16 text-cyan-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <h2 class="text-2xl font-bold text-white mb-2">درخواست ارزیابی ثبت شد</h2>
          <p class="text-slate-300">تیم مهندسی اکباتان به‌زودی جهت بررسی معماری با شما تماس خواهد گرفت.</p>
        </div>

        <div id="error-message" role="alert" class="hidden mb-6 p-4 rounded-xl bg-red-950/50 border border-red-800/70 text-red-300 text-sm"></div>

        <form id="assessment-form" class="space-y-6 text-right" dir="rtl">
          <input type="hidden" name="access_key" value="7a1d3c08-b0d1-4a8b-873e-cfd95c1d6c6d" />
          <input type="hidden" name="subject" value="درخواست جدید ارزیابی معماری Production از سایت Ekbatan.tech" />
          <input type="hidden" name="from_name" value="Ekbatan Tech System" />
          <input type="checkbox" name="botcheck" class="hidden" style="display: none;" tabindex="-1" autocomplete="off" />

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label for="company" class="block text-sm font-medium text-slate-300 mb-2">نام سازمان / شرکت</label>
              <input
                id="company"
                type="text"
                name="company"
                required
                class="w-full bg-[#0B101B] border border-slate-700 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 transition-colors"
              />
            </div>
            <div>
              <label for="email" class="block text-sm font-medium text-slate-300 mb-2">ایمیل سازمانی</label>
              <input
                id="email"
                type="email"
                name="email"
                required
                class="w-full bg-[#0B101B] border border-slate-700 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 transition-colors"
                dir="ltr"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label for="phone" class="block text-sm font-medium text-slate-300 mb-2">شماره تماس یا آیدی تلگرام (اختیاری)</label>
              <input
                id="phone"
                type="text"
                name="phone"
                placeholder="0912... / @username"
                class="w-full bg-[#0B101B] border border-slate-700 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 transition-colors"
                dir="ltr"
              />
            </div>
            <div>
              <label for="workload_type" class="block text-sm font-medium text-slate-300 mb-2">نوع بارهای کاری و دغدغه اصلی</label>
              <select
                id="workload_type"
                name="workload_type"
                class="w-full bg-[#0B101B] border border-slate-700 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-cyan-500 transition-colors"
              >
                <option value="kubernetes-production">استقرار Kubernetes برای محیط Production</option>
                <option value="stateful-storage">مدیریت Storage توزیع‌شده و Backup (Ceph)</option>
                <option value="high-traffic-networking">گلوگاه‌های شبکه، Load Balancing و eBPF</option>
                <option value="ai-mlops">زیرساخت MLOps و کلاسترهای GPU</option>
                <option value="sre-observability">مهندسی پایداری (SRE) و Observability</option>
                <option value="others">طراحی معماری جامع / سایر موارد</option>
              </select>
            </div>
          </div>

          <div>
            <label for="scale" class="block text-sm font-medium text-slate-300 mb-2">مقیاس تقریبی محیط عملیاتی (Nodes / ترافیک / حجم Storage)</label>
            <input
              id="scale"
              type="text"
              name="scale"
              placeholder="مثلاً: ۳۰ نود کوبرنتیز روی Bare Metal، ترافیک 50Gbps"
              class="w-full bg-[#0B101B] border border-slate-700 rounded-lg px-4 py-3 text-slate-300 focus:outline-none focus:border-cyan-500 transition-colors"
            />
          </div>

          <div>
            <label for="challenges" class="block text-sm font-medium text-slate-300 mb-2">الزامات پایداری، اهداف HA و توضیحات تکمیلی</label>
            <textarea
              id="challenges"
              name="challenges"
              rows="5"
              required
              placeholder="لطفاً نیازمندی‌های مرتبط با معماری Control Plane، چالش‌های Availability فعلی، یا اهداف Disaster Recovery را شرح دهید..."
              class="w-full bg-[#0B101B] border border-slate-700 rounded-lg px-4 py-3 text-slate-300 focus:outline-none focus:border-cyan-500 transition-colors resize-none"
            ></textarea>
          </div>

          <button
            id="submit-btn"
            type="submit"
            class="w-full bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold text-lg py-4 rounded-xl transition-all shadow-lg shadow-cyan-500/20 flex justify-center items-center gap-2 cursor-pointer"
          >
            <span>ثبت درخواست ارزیابی Production Readiness</span>
            <svg id="loading-spinner" class="animate-spin -ml-1 mr-3 h-5 w-5 text-slate-950 hidden" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
          </button>
        </form>
      </div>
    </div>
  </main>
  <Footer />
  <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
</Layout>

<script>
  const form = document.getElementById('assessment-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
  const submitText = submitBtn?.querySelector('span');
  const loadingSpinner = document.getElementById('loading-spinner');
  const successMessage = document.getElementById('success-message');
  const errorMessage = document.getElementById('error-message');

  form?.addEventListener('submit', async function (e) {
    e.preventDefault();
    if (!submitBtn || !submitText) return;

    errorMessage?.classList.add('hidden');
    submitBtn.disabled = true;
    submitBtn.classList.add('opacity-75', 'cursor-not-allowed');
    submitText.innerText = 'در حال ارسال...';
    loadingSpinner?.classList.remove('hidden');

    const formData = new FormData(form);
    const json = JSON.stringify(Object.fromEntries(formData));

    try {
      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Accept: 'application/json',
        },
        body: json,
      });

      const result = await response.json();

      if (response.ok) {
        successMessage?.classList.remove('hidden');
        form.reset();
      } else if (errorMessage) {
        errorMessage.textContent = `متاسفانه خطایی رخ داد: ${result.message || 'لطفاً مجدداً تلاش کنید.'}`;
        errorMessage.classList.remove('hidden');
      }
    } catch {
      if (errorMessage) {
        errorMessage.textContent = 'خطا در برقراری ارتباط با سرور. لطفاً اتصال اینترنت خود را بررسی کنید یا از طریق ایمیل info@ekbatan.tech در ارتباط باشید.';
        errorMessage.classList.remove('hidden');
      }
    } finally {
      submitBtn.disabled = false;
      submitBtn.classList.remove('opacity-75', 'cursor-not-allowed');
      submitText.innerText = 'ثبت درخواست ارزیابی Production Readiness';
      loadingSpinner?.classList.add('hidden');
    }
  });
</script>