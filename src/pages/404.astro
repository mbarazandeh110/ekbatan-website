---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="۴۰۴ - مسیر یافت نشد | اکباتان تک" robots="noindex, nofollow">
  <Navbar />

  <main class="flex flex-col items-center justify-center min-h-[70vh] px-4 text-center">
    <div class="space-y-6 max-w-2xl mx-auto">
      <h1 class="text-8xl md:text-9xl font-extrabold tracking-widest text-white font-mono">
        404
      </h1>

      <div class="inline-block bg-red-950/40 text-red-400 px-4 py-2 rounded-md font-mono text-sm md:text-base border border-red-800/50" dir="ltr">
        Error: Ingress route not matched / Resource not found
      </div>

      <h2 class="text-2xl md:text-3xl font-semibold text-slate-200 mt-4">
        صفحه مورد نظر یافت نشد
      </h2>

      <p class="text-slate-400 leading-relaxed mt-4">
        آدرس درخواستی تغییر کرده یا دیگر در دسترس نیست. می‌توانید از پیوندهای زیر به بخش‌های اصلی اکباتان تک مراجعه کنید:
      </p>

      <div class="pt-6 flex flex-wrap items-center justify-center gap-4">
        <a
          href="/"
          class="inline-flex items-center justify-center px-6 py-3 text-sm font-bold rounded-xl text-slate-950 bg-cyan-500 hover:bg-cyan-400 transition-all shadow-lg shadow-cyan-500/20"
        >
          صفحه اصلی
        </a>
        <a
          href="/services/"
          class="inline-flex items-center justify-center px-6 py-3 text-sm font-medium rounded-xl text-slate-200 bg-slate-900 hover:bg-slate-800 border border-slate-800 transition-all"
        >
          خدمات مهندسی
        </a>
        <a
          href="/enterprise/"
          class="inline-flex items-center justify-center px-6 py-3 text-sm font-medium rounded-xl text-slate-200 bg-slate-900 hover:bg-slate-800 border border-slate-800 transition-all"
        >
          استک‌های سازمانی
        </a>
        <a
          href="/experience/"
          class="inline-flex items-center justify-center px-6 py-3 text-sm font-medium rounded-xl text-slate-200 bg-slate-900 hover:bg-slate-800 border border-slate-800 transition-all"
        >
          مطالعات موردی
        </a>
        <a
          href="/blog/"
          class="inline-flex items-center justify-center px-6 py-3 text-sm font-medium rounded-xl text-slate-200 bg-slate-900 hover:bg-slate-800 border border-slate-800 transition-all"
        >
          بلاگ مهندسی
        </a>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
