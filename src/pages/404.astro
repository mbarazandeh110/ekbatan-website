---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="۴۰۴ - مسیر یافت نشد | شرکت اکباتان (Ekbatan)" robots="noindex, nofollow">
  <Navbar />
  
  <main class="flex flex-col items-center justify-center min-h-[70vh] px-4 text-center">
    <div class="space-y-6 max-w-2xl mx-auto">
      <h1 class="text-8xl md:text-9xl font-extrabold tracking-widest text-gray-900 dark:text-gray-100">
        404
      </h1>
      
      <div class="inline-block bg-red-100 text-red-700 dark:bg-red-900/30 dark:text-red-400 px-4 py-2 rounded-md font-mono text-sm md:text-base border border-red-200 dark:border-red-800/50">
        Error: Ingress route not matched / Resource not found
      </div>
      
      <h2 class="text-2xl md:text-3xl font-semibold text-gray-800 dark:text-gray-200 mt-4">
        پاسخی از نود (Node) دریافت نشد!
      </h2>
      
      <p class="text-gray-600 dark:text-gray-400 leading-relaxed mt-4">
        به نظر می‌رسد درخواست شما به یک مسیر نامعتبر هدایت شده است. ممکن است صفحه مورد نظر به یک کلاستر دیگر منتقل شده باشد یا در حال حاضر در دسترس نباشد.
      </p>
      
      <div class="pt-8">
        <a 
          href="/" 
          class="inline-flex items-center justify-center px-6 py-3 text-base font-medium rounded-lg text-white bg-blue-600 hover:bg-blue-700 dark:bg-blue-500 dark:hover:bg-blue-600 transition-all duration-200 shadow-sm hover:shadow"
        >
          بازگشت به داشبورد اصلی
        </a>
      </div>
    </div>
  </main>

  <Footer />
</Layout>