---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const teamMembers = [
  {
    name: "مهدی برازنده",
    initials: "MLB",
    colorClass: "text-cyan-400 bg-cyan-900/50 border-cyan-800",
    hoverClass: "group-hover:text-cyan-300",
    headline: "SRE | Focus on Kubernetes, CDN & Reliability",
    linkedin: "https://www.linkedin.com/in/mahdi-barazandeh/"
  },
  {
    name: "یاسین پرکار",
    initials: "YP",
    colorClass: "text-indigo-400 bg-indigo-900/50 border-indigo-800",
    hoverClass: "group-hover:text-indigo-300",
    headline: "SRE, K8S, Ceph | SRE Manager",
    linkedin: "https://www.linkedin.com/in/yasinporkar/"
  },
  {
    name: "رضا نجار",
    initials: "RN",
    colorClass: "text-indigo-400 bg-indigo-900/50 border-indigo-800",
    hoverClass: "group-hover:text-indigo-300",
    headline: "SRE Engineer",
    linkedin: "https://www.linkedin.com/in/reza-najjar-0337a5132/"
  },
  {
    name: "علی لطفی",
    initials: "AL",
    colorClass: "text-emerald-400 bg-emerald-900/50 border-emerald-800",
    hoverClass: "group-hover:text-emerald-300",
    headline: "Software Architecture Consultant & Data Specialist | Microservices & Data Lakehouse",
    linkedin: "https://www.linkedin.com/in/csalilotfi/"
  },
  {
    name: "حسین عیوضی",
    initials: "HE",
    colorClass: "text-fuchsia-400 bg-fuchsia-900/50 border-fuchsia-800",
    hoverClass: "group-hover:text-fuchsia-300",
    headline: "AI and Data Engineer",
    linkedin: "https://www.linkedin.com/in/hossein-eyvazi-7908231b8/"
  }
];
---

<Layout
title="درباره اکباتان | تخصص در سطح مأموریت‌بحرانی"
description="تیم مهندسی پلتفرم و معماری ابری اکباتان. متخصص در SRE، Kubernetes و زیرساخت‌های Enterprise."
>
  <Navbar />
  <main class="min-h-screen py-24 px-6 max-w-5xl mx-auto">

    <section class="text-center mb-20">
      <span class="text-xs font-mono text-cyan-400 tracking-widest uppercase">
        ABOUT EKBATAN
      </span>

      <h1 class="text-4xl md:text-6xl font-black text-white mt-4 mb-6">
        مهندسی پلتفرم در مقیاس Enterprise
      </h1>

      <p class="text-lg text-slate-400 max-w-3xl mx-auto leading-relaxed">
        اکباتان یک آژانس پشتیبانی IT نیست؛ ما یک تیم تخصصی
        <strong class="text-slate-200">&nbsp;Platform Engineering&nbsp;</strong>
        و
        <strong class="text-slate-200">&nbsp;SRE&nbsp;</strong>
        هستیم. تمرکز ما طراحی، پیاده‌سازی و نگهداری زیرساخت‌هایی است که
        کسب‌وکارهای ملی روی آن‌ها بدون قطعی
        <strong class="text-slate-200">&nbsp;(Zero-Downtime)&nbsp;</strong>
        رشد می‌کنند.
      </p>
    </section>

    <section class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-20">
      <article class="bg-slate-900/50 border border-slate-800 p-8 rounded-2xl">
        <h2 class="text-xl font-bold text-white mb-4">رویکرد SRE-First</h2>
        <p class="text-sm text-slate-400 leading-relaxed">
          مانیتورینگ عمیق با <strong class="text-slate-300">&nbsp;OpenTelemetry&nbsp;</strong>، مدیریت <strong class="text-slate-300">&nbsp;Error Budget&nbsp;</strong> و پیاده‌سازی خودکار <strong class="text-slate-300">&nbsp;Node Remediation</strong>. پایداری ۹۹.۹۹٪ با تنظیمات دستی به دست نمی‌آید؛ بلکه مهندسی می‌شود.
        </p>
      </article>

      <article class="bg-slate-900/50 border border-slate-800 p-8 rounded-2xl relative overflow-hidden">
        <div class="absolute top-0 left-0 w-full h-1 bg-emerald-500"></div>
        <h2 class="text-xl font-bold text-white mb-4 flex items-center gap-2">
          <span>امنیت و Compliance</span>
        </h2>
        <p class="text-sm text-slate-400 leading-relaxed">
          تغییرات زیرساخت ما مبتنی بر <strong class="text-slate-300">&nbsp;IaC&nbsp;</strong> و Vault است. ما اصول امنیتی نظیر <strong class="text-slate-300">&nbsp;Air-gapped Deployments&nbsp;</strong>، ممیزی‌های <strong class="text-slate-300">&nbsp;ISO 27001 / افتا&nbsp;</strong> و رمزنگاری توزیع‌شده را در معماری لحاظ می‌کنیم.
        </p>
      </article>

      <article class="bg-slate-900/50 border border-slate-800 p-8 rounded-2xl">
        <h2 class="text-xl font-bold text-white mb-4">مدل‌های همکاری</h2>
        <p class="text-sm text-slate-400 leading-relaxed">
          از معماری و ارزیابی <strong class="text-slate-300">&nbsp;(Assessment)&nbsp;</strong> در بازه ۲ تا ۴ هفته، تا پیاده‌سازی کامل و قراردادهای <strong class="text-slate-300">&nbsp;Managed Services&nbsp;</strong> شفاف با تضمین RTO و جبران نقض SLA.
        </p>
      </article>
    </section>

    <!-- Engineering Team -->
    <section class="mb-20">
      <div class="text-center mb-12">
        <span class="text-xs font-mono text-cyan-400 tracking-widest uppercase">CORE TEAM</span>
        <h2 class="text-3xl md:text-4xl font-bold text-white mt-3">تیم مهندسی و معماری اکباتان</h2>
        <p class="text-slate-400 mt-4 max-w-2xl mx-auto leading-relaxed">
          حضور متخصصین ارشد زیرساخت، SRE و معماری نرم‌افزار، تضمین‌کننده پایداری سیستم‌های شماست. ما فناوری را می‌سازیم، نه اینکه فقط آن را راه‌اندازی کنیم.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {teamMembers.map((member) => (
          <div class="bg-slate-900/50 border border-slate-800 p-6 rounded-2xl hover:border-cyan-500/40 transition-colors flex items-start gap-4 group">
            <div class={`w-14 h-14 rounded-xl border flex items-center justify-center font-black text-xl shrink-0 ${member.colorClass}`}>
              {member.initials}
            </div>
            <div>
              <h3 class={`text-lg font-bold text-white transition-colors ${member.hoverClass}`}>
                {member.name}
              </h3>
              <p class="text-xs font-mono text-slate-400 mt-1.5 mb-4 leading-relaxed">
                {member.headline}
              </p>
              <a href={member.linkedin} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-xs font-semibold text-cyan-500 hover:text-cyan-400 transition-colors">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
                مشاهده پروفایل لینکدین
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- What We Do -->
    <section class="mb-20">
      <div class="text-center mb-12">
        <span class="text-xs font-mono text-cyan-400 tracking-widest uppercase">WHAT WE DO</span>
        <h2 class="text-3xl md:text-4xl font-bold text-white mt-3">مهندسی برای پایداری، مقیاس و سرعت</h2>
        <p class="text-slate-400 mt-4 max-w-2xl mx-auto leading-relaxed">
          ما زیرساخت را صرفاً اجرا نمی‌کنیم؛ آن را برای رشد، اتوماسیون، مشاهده‌پذیری و تحمل خطا طراحی می‌کنیم.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div class="border border-slate-800 rounded-2xl p-6 bg-slate-950/50">
          <h3 class="text-lg font-bold text-white mb-2">Platform Engineering</h3>
          <p class="text-sm text-slate-400 leading-relaxed">طراحی و پیاده‌سازی پلتفرم‌های داخلی برای توسعه، استقرار و مدیریت سرویس‌ها.</p>
        </div>
        <div class="border border-slate-800 rounded-2xl p-6 bg-slate-950/50">
          <h3 class="text-lg font-bold text-white mb-2">Kubernetes & Cloud Native</h3>
          <p class="text-sm text-slate-400 leading-relaxed">طراحی، مهاجرت، بهینه‌سازی و مدیریت کلاسترهای Kubernetes در محیط‌های Enterprise.</p>
        </div>
        <div class="border border-slate-800 rounded-2xl p-6 bg-slate-950/50">
          <h3 class="text-lg font-bold text-white mb-2">SRE & Observability</h3>
          <p class="text-sm text-slate-400 leading-relaxed">طراحی سیستم‌های مانیتورینگ، Alerting، SLO و Error Budget برای افزایش قابلیت اطمینان.</p>
        </div>
        <div class="border border-slate-800 rounded-2xl p-6 bg-slate-950/50">
          <h3 class="text-lg font-bold text-white mb-2">Infrastructure Automation</h3>
          <p class="text-sm text-slate-400 leading-relaxed">اتوماسیون فرآیندهای عملیاتی با IaC، CI/CD و GitOps برای کاهش خطای انسانی.</p>
        </div>
      </div>
    </section>

    <!-- Technology -->
    <section class="mb-20">
      <div class="border border-slate-800 rounded-3xl p-8 md:p-12 bg-slate-900/30">
        <div class="text-center mb-10">
          <span class="text-xs font-mono text-cyan-400 tracking-widest uppercase">TECHNOLOGY</span>
          <h2 class="text-3xl font-bold text-white mt-3">تکنولوژی در خدمت معماری</h2>
        </div>
        <div class="flex flex-wrap justify-center gap-3">
          {["Kubernetes", "Linux", "GitOps", "Terraform", "Ansible", "Argo CD", "OpenTelemetry", "VictoriaMetrics", "Elasticsearch", "HashiCorp Vault", "Cilium", "GitLab CI/CD"].map((tech) => (
            <span class="px-4 py-2 rounded-full bg-slate-800 text-slate-300 text-sm">{tech}</span>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="text-center pb-8">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-5">زیرساخت شما، شایسته مهندسی است.</h2>
      <p class="text-slate-400 max-w-2xl mx-auto leading-relaxed mb-8">
        اگر زیرساخت شما با رشد کسب‌وکار پیچیده‌تر شده، زمان آن رسیده است که یک پلتفرم مهندسی‌شده بسازید.
      </p>
      <a href="/assessment" class="inline-flex items-center justify-center px-7 py-3 rounded-xl bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold transition-colors shadow-lg shadow-cyan-500/20">
        درخواست جلسه Technical Discovery
      </a>
    </section>
  </main>
  <Footer />
</Layout>