---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { teamMembers } from '../data/team';

const schemaData = [
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    name: 'درباره شرکت اکباتان (Ekbatan Tech)',
    url: 'https://ekbatan.tech/about/',
    description:
      'آشنایی با تیم مهندسی پلتفرم، معماری ابری و SRE شرکت اکباتان؛ متخصص در استقرار Kubernetes، Ceph، CDN و زیرساخت‌های Enterprise.',
    mainEntity: {
      '@type': 'Organization',
      '@id': 'https://ekbatan.tech/#organization',
      name: 'اکباتان تک (Ekbatan Tech)',
      alternateName: ['شرکت اکباتان', 'تیم مهندسی زیرساخت اکباتان'],
      url: 'https://ekbatan.tech/',
      logo: 'https://ekbatan.tech/Ekbatan_logo.png',
      email: 'm.barazandeh110@gmail.com',
      sameAs: [
        'https://ekbatan.tech',
        'https://github.com/ekbatan-tech',
      ],
      member: teamMembers.map((m) => ({
        '@type': 'Person',
        '@id': `https://ekbatan.tech/about/#${m.slug}`,
        name: m.name,
        jobTitle: m.headline,
        description: m.bio,
        sameAs: [m.linkedin],
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'خانه', item: 'https://ekbatan.tech/' },
      { '@type': 'ListItem', position: 2, name: 'درباره شرکت اکباتان', item: 'https://ekbatan.tech/about/' },
    ],
  },
];
---

<Layout
  title="درباره اکباتان تک | تیم مهندسی کوبرنتیز، Ceph و SRE"
  description="معرفی تیم مهندسان ارشد پلتفرم و SRE شرکت اکباتان (Ekbatan Tech)؛ طراح و مجری کلاسترهای کوبرنتیز سازمانی، استوریج Ceph و CDN در مقیاس ملی."
>
  <Navbar />
  <main class="min-h-screen py-24 px-6 max-w-5xl mx-auto">
    <nav aria-label="Breadcrumb" class="mb-8 text-xs font-mono text-slate-400 flex items-center justify-center gap-2">
      <a href="/" class="hover:text-cyan-400 transition-colors">خانه</a>
      <span>/</span>
      <span class="text-cyan-400">درباره شرکت اکباتان</span>
    </nav>

    <section class="text-center mb-20">
      <span class="text-xs font-mono text-cyan-400 tracking-widest uppercase">
        ABOUT EKBATAN TECH
      </span>

      <h1 class="text-4xl md:text-6xl font-black text-white mt-4 mb-6">
        درباره شرکت اکباتان؛ مهندسی پلتفرم در مقیاس Enterprise
      </h1>

      <p class="text-lg text-slate-400 max-w-3xl mx-auto leading-relaxed">
        شرکت اکباتان (Ekbatan Tech) یک آژانس پشتیبانی IT نیست؛ ما یک تیم تخصصی
        <strong class="text-slate-200">&nbsp;Platform Engineering&nbsp;</strong>
        و
        <strong class="text-slate-200">&nbsp;SRE&nbsp;</strong>
        هستیم. تمرکز ما طراحی، پیاده‌سازی و نگهداری زیرساخت‌هایی است که کسب‌وکارهای ملی روی آن‌ها بدون قطعی
        <strong class="text-slate-200">&nbsp;(Zero-Downtime)&nbsp;</strong>
        رشد می‌کنند.
      </p>
    </section>

    <section class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-20">
      <article class="bg-slate-900/50 border border-slate-800 p-8 rounded-2xl">
        <h2 class="text-xl font-bold text-white mb-4">رویکرد SRE-First</h2>
        <p class="text-sm text-slate-400 leading-relaxed">
          مانیتورینگ عمیق با <strong class="text-slate-300">&nbsp;OpenTelemetry&nbsp;</strong>، مدیریت <strong class="text-slate-300">&nbsp;Error Budget&nbsp;</strong> و پیاده‌سازی خودکار <strong class="text-slate-300">&nbsp;Node Remediation</strong>. پایداری ۹۹.۹۶٪ با تنظیمات دستی به دست نمی‌آید؛ بلکه مهندسی می‌شود.
        </p>
      </article>

      <article class="bg-slate-900/50 border border-slate-800 p-8 rounded-2xl relative overflow-hidden">
        <div class="absolute top-0 left-0 w-full h-1 bg-emerald-500"></div>
        <h2 class="text-xl font-bold text-white mb-4">امنیت و Compliance</h2>
        <p class="text-sm text-slate-400 leading-relaxed">
          تغییرات زیرساخت ما مبتنی بر <strong class="text-slate-300">&nbsp;IaC&nbsp;</strong> و Vault است. ما اصول امنیتی نظیر <strong class="text-slate-300">&nbsp;Air-gapped Deployments&nbsp;</strong>، ممیزی‌های <strong class="text-slate-300">&nbsp;ISO 27001 / افتا&nbsp;</strong> و رمزنگاری توزیع‌شده را در معماری لحاظ می‌کنیم.
        </p>
      </article>

      <article class="bg-slate-900/50 border border-slate-800 p-8 rounded-2xl">
        <h2 class="text-xl font-bold text-white mb-4">مدل‌های همکاری</h2>
        <p class="text-sm text-slate-400 leading-relaxed">
          از معماری و ارزیابی <strong class="text-slate-300">&nbsp;(Assessment)&nbsp;</strong> در بازه ۲ تا ۴ هفته، تا پیاده‌سازی کامل و قراردادهای <strong class="text-slate-300">&nbsp;Managed Services&nbsp;</strong> شفاف با تضمین RTO و جبران نقض SLA.
        </p>
      </article>
    </section>

    <section class="mb-20">
      <div class="text-center mb-12">
        <span class="text-xs font-mono text-cyan-400 tracking-widest uppercase">CORE TEAM</span>
        <h2 class="text-3xl md:text-4xl font-bold text-white mt-3">تیم مهندسی و معماری شرکت اکباتان</h2>
        <p class="text-slate-400 mt-4 max-w-2xl mx-auto leading-relaxed">
          حضور متخصصین ارشد زیرساخت، SRE و معماری نرم‌افزار، تضمین‌کننده پایداری سیستم‌های شماست. ما فناوری را می‌سازیم، نه اینکه فقط آن را راه‌اندازی کنیم.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {teamMembers.map((member) => (
          <div id={member.slug} class="bg-slate-900/50 border border-slate-800 p-6 rounded-2xl hover:border-cyan-500/40 transition-colors flex items-start gap-4 group scroll-mt-24">
            <div class={`w-14 h-14 rounded-xl border flex items-center justify-center font-black text-xl shrink-0 ${member.colorClass}`}>
              {member.initials}
            </div>
            <div>
              <h3 class={`text-lg font-bold text-white transition-colors ${member.hoverClass}`}>
                {member.name}
              </h3>
              <p class="text-xs font-mono text-slate-400 mt-1.5 mb-2 leading-relaxed">
                {member.headline}
              </p>
              <p class="text-xs text-slate-400 mb-4 leading-relaxed">
                {member.bio}
              </p>
              <a href={member.linkedin} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-xs font-semibold text-cyan-500 hover:text-cyan-400 transition-colors">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
                مشاهده پروفایل لینکدین
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="mb-20">
      <div class="text-center mb-12">
        <span class="text-xs font-mono text-cyan-400 tracking-widest uppercase">WHAT WE DO</span>
        <h2 class="text-3xl md:text-4xl font-bold text-white mt-3">مهندسی برای پایداری، مقیاس و سرعت</h2>
        <p class="text-slate-400 mt-4 max-w-2xl mx-auto leading-relaxed">
          ما زیرساخت را صرفاً اجرا نمی‌کنیم؛ آن را برای رشد، اتوماسیون، مشاهده‌پذیری و تحمل خطا طراحی می‌کنیم.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <a href="/services/" class="border border-slate-800 hover:border-cyan-500/40 rounded-2xl p-6 bg-slate-950/50 transition-colors block">
          <h3 class="text-lg font-bold text-white mb-2">Platform Engineering</h3>
          <p class="text-sm text-slate-400 leading-relaxed">طراحی و پیاده‌سازی پلتفرم‌های داخلی برای توسعه، استقرار و مدیریت سرویس‌ها.</p>
        </a>
        <a href="/services/kubernetes/" class="border border-slate-800 hover:border-cyan-500/40 rounded-2xl p-6 bg-slate-950/50 transition-colors block">
          <h3 class="text-lg font-bold text-white mb-2">Kubernetes &amp; Cloud Native</h3>
          <p class="text-sm text-slate-400 leading-relaxed">طراحی، مهاجرت، بهینه‌سازی و مدیریت کلاسترهای Kubernetes در محیط‌های Enterprise.</p>
        </a>
        <a href="/services/elasticsearch-enterprise/" class="border border-slate-800 hover:border-cyan-500/40 rounded-2xl p-6 bg-slate-950/50 transition-colors block">
          <h3 class="text-lg font-bold text-white mb-2">SRE &amp; Observability</h3>
          <p class="text-sm text-slate-400 leading-relaxed">طراحی سیستم‌های مانیتورینگ، Alerting، SLO و Error Budget برای افزایش قابلیت اطمینان.</p>
        </a>
        <a href="/services/enterprise-devops-gitlab/" class="border border-slate-800 hover:border-cyan-500/40 rounded-2xl p-6 bg-slate-950/50 transition-colors block">
          <h3 class="text-lg font-bold text-white mb-2">Infrastructure Automation</h3>
          <p class="text-sm text-slate-400 leading-relaxed">اتوماسیون فرآیندهای عملیاتی با IaC، CI/CD و GitOps برای کاهش خطای انسانی.</p>
        </a>
      </div>
    </section>

    <section class="mb-20">
      <div class="border border-slate-800 rounded-3xl p-8 md:p-12 bg-slate-900/30">
        <div class="text-center mb-10">
          <span class="text-xs font-mono text-cyan-400 tracking-widest uppercase">TECHNOLOGY</span>
          <h2 class="text-3xl font-bold text-white mt-3">تکنولوژی در خدمت معماری</h2>
        </div>
        <div class="flex flex-wrap justify-center gap-3">
          {['Kubernetes', 'Linux', 'GitOps', 'Terraform', 'Ansible', 'Argo CD', 'OpenTelemetry', 'VictoriaMetrics', 'Elasticsearch', 'HashiCorp Vault', 'Cilium', 'GitLab CI/CD'].map((tech) => (
            <span class="px-4 py-2 rounded-full bg-slate-800 text-slate-300 text-sm">{tech}</span>
          ))}
        </div>
      </div>
    </section>

    <section class="text-center pb-8">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-5">زیرساخت شما، شایسته مهندسی است.</h2>
      <p class="text-slate-400 max-w-2xl mx-auto leading-relaxed mb-8">
        اگر زیرساخت شما با رشد کسب‌وکار پیچیده‌تر شده، زمان آن رسیده است که یک پلتفرم مهندسی‌شده بسازید.
      </p>
      <a href="/assessment/" class="inline-flex items-center justify-center px-7 py-3 rounded-xl bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold transition-colors shadow-lg shadow-cyan-500/20">
        درخواست جلسه Technical Discovery
      </a>
    </section>
  </main>
  <Footer />
  <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
</Layout>