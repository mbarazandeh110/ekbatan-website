---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const tools = (await getCollection('tools')).sort((a, b) => a.data.name.localeCompare(b.data.name));

const title = 'استقرار استک‌های سازمانی (Enterprise) روی کوبرنتیز | اکباتان تک';
const description =
  'معماری مرجع، نصب امن، کلاسترینگ High Availability و بک‌آپ خودکار ابزارهای سازمانی شامل GitLab، Elasticsearch (ECK)، Jira، Confluence، n8n، Nexus، JFrog و Mattermost روی کوبرنتیز.';

const schemaData = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'استک‌های سازمانی قابل استقرار اکباتان',
    itemListElement: tools.map((tool, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: `https://ekbatan.tech/enterprise/${tool.id}/`,
      name: tool.data.name,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'خانه', item: 'https://ekbatan.tech/' },
      { '@type': 'ListItem', position: 2, name: 'استک‌های سازمانی', item: 'https://ekbatan.tech/enterprise/' },
    ],
  },
];
---

<Layout title={title} description={description}>
  <Navbar />

  <main class="py-20 px-6 max-w-6xl mx-auto min-h-[70vh]">
    <nav aria-label="Breadcrumb" class="mb-8 text-xs font-mono text-slate-400 flex items-center justify-center gap-2">
      <a href="/" class="hover:text-cyan-400 transition-colors">خانه</a>
      <span>/</span>
      <span class="text-cyan-400">استک‌های سازمانی</span>
    </nav>

    <div class="mb-14 text-center">
      <span class="text-xs font-mono text-cyan-400 tracking-widest uppercase">ENTERPRISE SOLUTIONS</span>
      <h1 class="text-3xl md:text-5xl font-black text-white mt-4 mb-6">
        استقرار نسخه‌های سازمانی روی <span class="text-cyan-400">کوبرنتیز و Bare-Metal</span>
      </h1>
      <p class="text-slate-400 text-base md:text-lg max-w-3xl mx-auto leading-relaxed font-light">
        معماری مرجع، پیاده‌سازی High Availability، اتصال به استوریج Ceph و دیتابیس‌های HA، و پایش SRE برای پشته‌های کلیدی سازمان شما.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {tools.map((tool) => (
        <a
          href={`/enterprise/${tool.id}/`}
          class="p-6 rounded-2xl bg-slate-900/60 border border-slate-800 hover:border-cyan-500/40 hover:bg-slate-950 transition-all flex flex-col justify-between group shadow-lg"
        >
          <div>
            <div class="flex items-center justify-between gap-2 mb-3">
              <span class="text-[10px] font-mono text-cyan-400 bg-cyan-950/50 px-2.5 py-1 rounded border border-cyan-900/40">
                {tool.data.category}
              </span>
              <span class="text-[10px] font-mono text-slate-500">{tool.data.badge}</span>
            </div>
            <h2 class="text-lg font-bold text-white font-mono group-hover:text-cyan-300 transition-colors mb-2">
              {tool.data.name}
            </h2>
            <p class="text-xs text-slate-400 leading-relaxed line-clamp-3">
              {tool.data.description}
            </p>
          </div>
          <div class="mt-5 pt-3 border-t border-slate-800/60 flex items-center justify-between text-xs text-cyan-400">
            <span>مشاهده معماری و YAML</span>
            <span class="font-mono group-hover:translate-x-[-4px] transition-transform">←</span>
          </div>
        </a>
      ))}
    </div>

    <div class="mt-20 p-10 rounded-3xl bg-gradient-to-r from-slate-900 via-slate-900/80 to-cyan-950/30 border border-cyan-900/40 text-center text-white">
      <h2 class="text-xl md:text-2xl font-bold mb-3">نیاز به استقرار Air-Gapped یا مهاجرت بدون قطعی دارید؟</h2>
      <p class="text-slate-300 text-sm max-w-2xl mx-auto mb-6 leading-relaxed">
        تمامی استک‌های سازمانی فوق با <a href="/services/kubernetes/" class="text-cyan-400 hover:underline">کوبرنتیز سازمانی</a>، <a href="/services/ceph/" class="text-cyan-400 hover:underline">استوریج Ceph</a> و <a href="/services/enterprise-databases/" class="text-cyan-400 hover:underline">دیتابیس‌های HA</a> یکپارچه می‌شوند.
      </p>
      <a
        href="/assessment/"
        class="inline-flex items-center gap-2 px-8 py-3.5 rounded-xl bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold text-sm transition-all shadow-lg shadow-cyan-500/25"
      >
        درخواست ارزیابی معماری (Assessment)
        <span>↗</span>
      </a>
    </div>
  </main>

  <Footer />
  <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
</Layout>